<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<BorderPane fx:controller="servicart.controllers.SobreNosotrosController" prefWidth="800" prefHeight="600" style="-fx-background-color: #0f0f0f;" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: #161616; -fx-border-color: #222222; -fx-border-width: 0 0 1 0; -fx-padding: 12 20 12 20;">
            <Label text="SERVICART" style="-fx-text-fill: #e8c96d; -fx-font-size: 15; -fx-font-weight: bold; -fx-font-family: 'Courier New';"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="inicio" onAction="#irAMain" style="-fx-background-color: transparent; -fx-text-fill: #666666; -fx-border-color: transparent; -fx-font-size: 12; -fx-padding: 5 14 5 14; -fx-cursor: hand;"/>
            <Button text="sobre nosotros" style="-fx-background-color: #1f1f1f; -fx-text-fill: #e8c96d; -fx-border-color: #2a2a2a; -fx-border-width: 1; -fx-border-radius: 4; -fx-background-radius: 4; -fx-font-size: 12; -fx-padding: 5 14 5 14; -fx-cursor: hand;"/>
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="12" style="-fx-background-color: #0f0f0f; -fx-padding: 32 40 32 40;">
            <Label text="SOBRE NOSOTROS" style="-fx-text-fill: #e8c96d; -fx-font-size: 20; -fx-font-family: 'Courier New';"/>
            <Separator prefWidth="40"/>

            <TextArea promptText="Escribe aquí la descripción del equipo..." prefWidth="460" prefHeight="90" wrapText="true" style="-fx-control-inner-background: #1a1a1a; -fx-background-color: #1a1a1a; -fx-border-color: #2e2e2e; -fx-border-width: 1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-text-fill: #aaaaaa; -fx-prompt-text-fill: #3a3a3a; -fx-font-size: 13;">
                <VBox.margin><Insets top="8" bottom="16"/></VBox.margin>
            </TextArea>

            <HBox spacing="20" alignment="CENTER">
                <VBox alignment="CENTER" spacing="10" prefWidth="160" style="-fx-background-color: #161616; -fx-border-color: #222222; -fx-border-width: 1; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 20 16 20 16;">
                    <ImageView fitWidth="150" fitHeight="150" preserveRatio="true">
                        <Image url="@../assets/img/Ai Hoshino.jpg"/>
                    </ImageView>

                    <Label text="Nombre 1" style="-fx-text-fill: #aaaaaa; -fx-font-size: 13;"/>
                </VBox>

                <VBox alignment="CENTER" spacing="10" prefWidth="160" style="-fx-background-color: #161616; -fx-border-color: #222222; -fx-border-width: 1; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 20 16 20 16;">
                    <ImageView fitWidth="150" fitHeight="150" preserveRatio="true">
                        <Image url="@../assets/img/Hornet.png"/>
                    </ImageView>

                    <Label text="Nombre 2" style="-fx-text-fill: #aaaaaa; -fx-font-size: 13;"/>
                </VBox>
            </HBox>
        </VBox>
    </center>
</BorderPane>