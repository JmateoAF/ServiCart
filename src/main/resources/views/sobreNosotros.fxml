<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>

<VBox alignment="CENTER" spacing="20" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="servicart.controllers.SobreNosotrosController">
    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <Label text="Sobre Nosotros" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>

    <TextArea text="ServiCart es un sistema diseñado para la gestión eficiente de... xd luego poner una descripción mejor"
              prefWidth="500" prefHeight="120" wrapText="true" editable="false"
              style="-fx-font-size: 14px;"/>

    <HBox alignment="CENTER" spacing="60">

        <VBox alignment="CENTER" spacing="8">
            <ImageView fitWidth="500" fitHeight="500" preserveRatio="true">
                <Image url="@/assets/img/Ai Hoshino.jpg"/>
            </ImageView>
            <Label text="Jostin Aucancela" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
        </VBox>

        <VBox alignment="CENTER" spacing="8">
            <ImageView fitWidth="500" fitHeight="500" preserveRatio="true">
                <Image url="@/assets/img/Hornet.png"/>
            </ImageView>
            <Label text="Maritza Quispi" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
        </VBox>

    </HBox>

    <Button text="Regresar" onAction="#irAMain" prefWidth="120" prefHeight="35"
            style="-fx-font-size: 14px;"/>

</VBox>