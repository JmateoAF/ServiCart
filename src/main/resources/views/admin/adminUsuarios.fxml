<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefWidth="1000" prefHeight="660"
            style="-fx-background-color: #0f0f0f;"
            stylesheets="@../../assets/css/styles.css"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="servicart.ui.controllers.admin.AdminUsuariosController"
>

    <top>
        <HBox alignment="CENTER_LEFT"
              style="-fx-background-color: #161616; -fx-border-color: #222222; -fx-border-width: 0 0 1 0; -fx-padding: 10 20 10 20;">
            <Label text="SERVICART ADMIN"
                   style="-fx-text-fill: #e8c96d; -fx-font-weight: bold; -fx-font-family: 'Courier New'; -fx-font-size: 25;"/>
        </HBox>
    </top>

    <left>
        <VBox prefWidth="200"
              style="-fx-background-color: #111111; -fx-border-color: #1e1e1e; -fx-border-width: 0 1 0 0;">
            <Label text="ADMIN"
                   style="-fx-text-fill: #e8c96d; -fx-font-family: 'Courier New'; -fx-font-weight: bold; -fx-border-color: #1e1e1e; -fx-border-width: 0 0 1 0; -fx-font-size: 20; -fx-padding: 0 15 10 15;"/>
            <Region prefHeight="5"/>
            <Button fx:id="btnUsuarios" onAction="#onUsuarios" text="👥 Usuarios" maxWidth="Infinity"
                    style="-fx-background-color: #1a1a0d; -fx-text-fill: #e8c96d; -fx-border-color: #e8c96d; -fx-border-width: 0 0 0 2; -fx-border-radius: 0; -fx-background-radius: 0; -fx-alignment: center-left; -fx-cursor: hand; -fx-font-size: 20; -fx-padding: 10 15 10 10;"/>
            <Button fx:id="btnTarifas" onAction="#onTarifas" text="⚙ Tarifas" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-border-color: transparent; -fx-alignment: center-left; -fx-cursor: hand; -fx-font-size: 20; -fx-padding: 10 15 10 15;"/>
            <Button fx:id="btnCortes" onAction="#onCortes" text="⚠ Cortes/mora" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-border-color: transparent; -fx-alignment: center-left; -fx-cursor: hand; -fx-font-size: 20; -fx-padding: 10 15 10 15;"/>
            <Button fx:id="btnEmpresas" onAction="#onEmpresas" text="🏢 Empresas" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-border-color: transparent; -fx-alignment: center-left; -fx-cursor: hand; -fx-font-size: 20; -fx-padding: 10 15 10 15;"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Button fx:id="btnSalir" onAction="#onSalir" text="⬅ Salir" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #c0392b; -fx-border-color: transparent; -fx-alignment: center-left; -fx-cursor: hand; -fx-font-size: 20; -fx-padding: 10 15 10 15;"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="10" style="-fx-background-color: #0f0f0f; -fx-padding: 15 20 20 20;">

            <!-- Toggle SQLite / Binario: reconfigura FactoryDAO para toda la sesión de la app -->
            <HBox maxWidth="-Infinity" style="-fx-border-color: #2a2a2a; -fx-border-width: 1; -fx-border-radius: 6; -fx-background-radius: 6;">
                <Button fx:id="btnSQLite" onAction="#onSeleccionarSQLite" style="-fx-background-color: #1e1c0f; -fx-text-fill: #e8c96d; -fx-border-color: transparent; -fx-cursor: hand; -fx-background-radius: 5 0 0 5; -fx-font-size: 15; -fx-padding: 5 15 5 15;" text="SQLite" />
                <Button fx:id="btnBinario" onAction="#onSeleccionarBinario" style="-fx-background-color: #161616; -fx-text-fill: #555555; -fx-border-color: transparent; -fx-cursor: hand; -fx-background-radius: 0 5 5 0; -fx-font-size: 15; -fx-padding: 5 15 5 15;" text="Archivos binarios" />
            </HBox>

            <!-- Stat cards: criterio de negocio (usuarios activos, cortados, con mora) -->
            <HBox spacing="10">
                <VBox alignment="CENTER_LEFT" style="-fx-background-color: #161616; -fx-border-color: #222222; -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 5 0 10 10;" HBox.hgrow="ALWAYS">
                    <Label style="-fx-text-fill: #555555; -fx-font-size: 15;" text="USUARIOS ACTIVOS" />
                    <Label fx:id="lblUsuariosActivos" style="-fx-text-fill: #e8c96d; -fx-font-family: 'Courier New'; -fx-font-weight: bold; -fx-font-size: 20;" text="0" />
                </VBox>
                <VBox alignment="CENTER_LEFT" style="-fx-background-color: #161616; -fx-border-color: #222222; -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 5 0 10 10;" HBox.hgrow="ALWAYS">
                    <Label style="-fx-text-fill: #555555; -fx-font-size: 15;" text="CORTADOS" />
                    <Label fx:id="lblCortados" style="-fx-text-fill: #c0392b; -fx-font-family: 'Courier New'; -fx-font-weight: bold; -fx-font-size: 20;" text="0" />
                </VBox>
                <VBox alignment="CENTER_LEFT" style="-fx-background-color: #161616; -fx-border-color: #222222; -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 5 0 10 10;" HBox.hgrow="ALWAYS">
                    <Label style="-fx-text-fill: #555555; -fx-font-size: 15;" text="CON MORA" />
                    <Label fx:id="lblConMora" style="-fx-text-fill: #e07b39; -fx-font-family: 'Courier New'; -fx-font-weight: bold; -fx-font-size: 20;" text="0" />
                </VBox>
            </HBox>

            <!-- Búsqueda -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="txtBuscar" promptText="Buscar por cédula, nombre o email..."
                           HBox.hgrow="ALWAYS"
                           style="-fx-background-color: #1a1a1a; -fx-border-color: #2e2e2e; -fx-border-width: 1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-text-fill: #aaaaaa; -fx-prompt-text-fill: #3a3a3a; -fx-font-family: 'Courier New'; -fx-font-size: 15; -fx-padding: 5 10 5 10;"/>
            </HBox>

            <!-- Lista de usuarios: filas simples en vez de TableView, para que las acciones
                 (Editar/Activar/Desactivar) se vean completas y no recortadas por el ancho de columna -->
            <VBox VBox.vgrow="ALWAYS"
                  style="-fx-background-color: #161616; -fx-border-color: #222222; -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8;">
                <HBox alignment="CENTER_LEFT"
                      style="-fx-padding: 10 15 10 15; -fx-border-color: #222222; -fx-border-width: 0 0 1 0;">
                    <Label text="USUARIOS REGISTRADOS"
                           style="-fx-text-fill: #555555; -fx-font-family: 'Courier New'; -fx-font-size: 15;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblConteo" text="0 registros"
                           style="-fx-text-fill: #444444; -fx-font-size: 15;"/>
                </HBox>
                <HBox spacing="15" style="-fx-padding: 10 15 10 15; -fx-border-color: #1e1e1e; -fx-border-width: 0 0 1 0;">
                    <Label prefWidth="110" text="CÉDULA" style="-fx-text-fill: #444444; -fx-font-family: 'Courier New'; -fx-font-size: 15;"/>
                    <Label prefWidth="150" text="NOMBRE" style="-fx-text-fill: #444444; -fx-font-family: 'Courier New'; -fx-font-size: 15;"/>
                    <Label prefWidth="200" text="EMAIL" style="-fx-text-fill: #444444; -fx-font-family: 'Courier New'; -fx-font-size: 15;"/>
                    <Label prefWidth="110" text="TELÉFONO" style="-fx-text-fill: #444444; -fx-font-family: 'Courier New'; -fx-font-size: 15;"/>
                    <Label prefWidth="80" text="ESTADO" style="-fx-text-fill: #444444; -fx-font-family: 'Courier New'; -fx-font-size: 15;"/>
                    <Label text="ACCIONES" style="-fx-text-fill: #444444; -fx-font-family: 'Courier New'; -fx-font-size: 15;"/>
                    <Region HBox.hgrow="ALWAYS" />
                </HBox>
                <VBox fx:id="listaUsuarios" VBox.vgrow="ALWAYS" />
            </VBox>

            <!-- Formulario editar/nuevo -->
            <VBox spacing="15" style="-fx-background-color: #161616; -fx-border-color: #252525; -fx-border-width: 1; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 20;">
                <Label text="EDITAR / NUEVO USUARIO"
                       style="-fx-text-fill: #e8c96d; -fx-font-family: 'Courier New'; -fx-border-color: #222222; -fx-border-width: 0 0 1 0; -fx-font-size: 20; -fx-padding: 0 0 10 0;"/>
                <HBox spacing="10">
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="CÉDULA" style="-fx-text-fill: #555555; -fx-font-size: 15;"/>
                        <TextField fx:id="txtCedulaForm" promptText="0102030405"
                                   style="-fx-background-color: #1a1a1a; -fx-border-color: #2e2e2e; -fx-border-width: 1; -fx-border-radius: 5; -fx-background-radius: 5; -fx-text-fill: #aaaaaa; -fx-prompt-text-fill: #3a3a3a; -fx-font-family: 'Courier New'; -fx-font-size: 15; -fx-padding: 5 10 5 10;"/>
                    </VBox>
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="NOMBRE" style="-fx-text-fill: #555555; -fx-font-size: 15;"/>
                        <TextField fx:id="txtNombreForm" promptText="Nombre completo"
                                   style="-fx-background-color: #1a1a1a; -fx-border-color: #2e2e2e; -fx-border-width: 1; -fx-border-radius: 5; -fx-background-radius: 5; -fx-text-fill: #aaaaaa; -fx-prompt-text-fill: #3a3a3a; -fx-font-size: 15; -fx-padding: 5 10 5 10;"/>
                    </VBox>
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="EMAIL" style="-fx-text-fill: #555555; -fx-font-size: 15;"/>
                        <TextField fx:id="txtEmailForm" promptText="correo@mail.com"
                                   style="-fx-background-color: #1a1a1a; -fx-border-color: #2e2e2e; -fx-border-width: 1; -fx-border-radius: 5; -fx-background-radius: 5; -fx-text-fill: #aaaaaa; -fx-prompt-text-fill: #3a3a3a; -fx-font-size: 15; -fx-padding: 5 10 5 10;"/>
                    </VBox>
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="TELÉFONO" style="-fx-text-fill: #555555; -fx-font-size: 15;"/>
                        <TextField fx:id="txtCelularForm" promptText="09XXXXXXXX"
                                   style="-fx-background-color: #1a1a1a; -fx-border-color: #2e2e2e; -fx-border-width: 1; -fx-border-radius: 5; -fx-background-radius: 5; -fx-text-fill: #aaaaaa; -fx-prompt-text-fill: #3a3a3a; -fx-font-family: 'Courier New'; -fx-font-size: 15; -fx-padding: 5 10 5 10;"/>
                    </VBox>
                    <VBox spacing="5">
                        <Label text="ESTADO" style="-fx-text-fill: #555555; -fx-font-size: 15;"/>
                        <ComboBox fx:id="cmbEstadoForm" promptText="Estado" prefWidth="110"
                                  style="-fx-background-color: #1a1a1a; -fx-border-color: #2e2e2e; -fx-border-width: 1; -fx-border-radius: 5; -fx-background-radius: 5; -fx-font-size: 15;"/>
                    </VBox>
                </HBox>
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Button fx:id="btnCancelar" onAction="#onCancelar" text="Cancelar"
                            style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-border-color: #2a2a2a; -fx-border-width: 1; -fx-border-radius: 5; -fx-background-radius: 5; -fx-cursor: hand; -fx-font-size: 15; -fx-padding: 5 15 5 15;"/>
                    <Button fx:id="btnGuardar" onAction="#onGuardar" text="Guardar"
                            style="-fx-background-color: #e8c96d; -fx-text-fill: #0f0f0f; -fx-font-weight: bold; -fx-border-radius: 5; -fx-background-radius: 5; -fx-cursor: hand; -fx-font-size: 15; -fx-padding: 5 15 5 15;"/>
                </HBox>
            </VBox>

        </VBox>
    </center>

</BorderPane>
