<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane style="-fx-background-color: #0f0f0f;" stylesheets="@../../assets/css/styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="servicart.ui.controllers.admin.AdminUsuariosController">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="70.0" style="-fx-background-color: #161616; -fx-border-color: #222222; -fx-border-width: 0 0 1 0; -fx-padding: 10 20 10 20;">
            <Label style="-fx-text-fill: #e8c96d; -fx-font-weight: bold; -fx-font-family: 'Courier New'; -fx-font-size: 25;" text="SERVICART ADMIN" />
         <Region prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS" />

            <HBox style="-fx-border-color: #2a2a2a; -fx-border-width: 1; -fx-border-radius: 5; -fx-background-radius: 5;">
                <Button fx:id="btnSQLite" maxHeight="Infinity" onAction="#onSeleccionarSQLite" style="-fx-background-color: #1e1c0f; -fx-text-fill: #e8c96d; -fx-border-color: transparent; -fx-cursor: hand; -fx-background-radius: 5; -fx-font-size: 20; -fx-padding: 5 15 5 15;" text="SQLite" />
                <Button fx:id="btnBinario" maxHeight="Infinity" onAction="#onSeleccionarBinario" style="-fx-background-color: #161616; -fx-text-fill: #555555; -fx-border-color: transparent; -fx-cursor: hand; -fx-background-radius: 5; -fx-font-size: 20; -fx-padding: 5 15 5 15;" text="Archivos binarios" />
            </HBox>
        </HBox>
    </top>

    <left>
        <VBox prefWidth="200.0" style="-fx-background-color: #0f0f0f; -fx-border-color: #1e1e1e; -fx-border-width: 0 1 0 0;">
            <Region prefHeight="5.0" style="-fx-background-color: #1e1e1e; -fx-border-color: #1e1e1e;" />
            <Button maxWidth="Infinity" style="-fx-background-color: #1a1a0d; -fx-text-fill: #e8c96d; -fx-border-color: #e8c96d; -fx-border-width: 0 0 0 5; -fx-font-size: 20; -fx-padding: 10 15 10 10; -fx-alignment: center-left; -fx-cursor: hand;" text="Usuarios" />
            <Button maxWidth="Infinity" onAction="#onTarifas" style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-border-color: transparent; -fx-font-size: 20; -fx-padding: 10 15 10 15; -fx-alignment: center-left; -fx-cursor: hand;" text="Tarifas" />
            <Button maxWidth="Infinity" onAction="#onCortes" style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-border-color: transparent; -fx-font-size: 20; -fx-padding: 10 15 10 15; -fx-alignment: center-left; -fx-cursor: hand;" text="Cortes/mora" />
            <Button maxWidth="Infinity" onAction="#onEmpresas" style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-border-color: transparent; -fx-font-size: 20; -fx-padding: 10 15 10 15; -fx-alignment: center-left; -fx-cursor: hand;" text="Empresas" />
            <Region VBox.vgrow="ALWAYS" />
         <Separator style="-fx-background-color: #1e1e1e;" />
            <Button maxWidth="Infinity" onAction="#onSalir" style="-fx-background-color: transparent; -fx-text-fill: #c0392b; -fx-border-color: transparent; -fx-font-size: 20; -fx-padding: 10 15 10 15; -fx-alignment: center-left; -fx-cursor: hand;" text="Salir" />
        </VBox>
    </left>

    <center>
        <VBox spacing="10" style="-fx-background-color: #0f0f0f; -fx-padding: 20;">

            <HBox spacing="10">
                <VBox alignment="CENTER_LEFT" style="-fx-background-color: #161616; -fx-border-color: #222222; -fx-border-width: 1; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 10;" HBox.hgrow="ALWAYS">
                    <Label style="-fx-text-fill: #555555; -fx-font-size: 15;" text="USUARIOS ACTIVOS" />
                    <Label fx:id="lblUsuariosActivos" style="-fx-text-fill: #e8c96d; -fx-font-family: 'Courier New'; -fx-font-weight: bold; -fx-font-size: 20;" text="0" />
                </VBox>
                <VBox alignment="CENTER_LEFT" style="-fx-background-color: #161616; -fx-border-color: #222222; -fx-border-width: 1; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 10;" HBox.hgrow="ALWAYS">
                    <Label style="-fx-text-fill: #555555; -fx-font-size: 15;" text="CORTADOS" />
                    <Label fx:id="lblCortados" style="-fx-text-fill: #c0392b; -fx-font-family: 'Courier New'; -fx-font-weight: bold; -fx-font-size: 20;" text="0" />
                </VBox>
                <VBox alignment="CENTER_LEFT" style="-fx-background-color: #161616; -fx-border-color: #222222; -fx-border-width: 1; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 10;" HBox.hgrow="ALWAYS">
                    <Label style="-fx-text-fill: #555555; -fx-font-size: 15;" text="CON MORA" />
                    <Label fx:id="lblConMora" style="-fx-text-fill: #e07b39; -fx-font-family: 'Courier New'; -fx-font-weight: bold; -fx-font-size: 20;" text="0" />
                </VBox>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="10">
                <TextField fx:id="txtBuscar" promptText="Buscar por cédula, nombre o email..." style="-fx-background-color: #1a1a1a; -fx-border-color: #2e2e2e; -fx-border-width: 1; -fx-border-radius: 5; -fx-background-radius: 5; -fx-text-fill: #aaaaaa; -fx-prompt-text-fill: #3a3a3a; -fx-font-family: 'Courier New'; -fx-font-size: 15; -fx-padding: 10;" HBox.hgrow="ALWAYS" />
            </HBox>

            <VBox style="-fx-background-color: #161616; -fx-border-color: #222222; -fx-border-width: 1; -fx-border-radius: 10; -fx-background-radius: 10;" VBox.vgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" style="-fx-padding: 10 15 10 15; -fx-border-color: #222222; -fx-border-width: 0 0 1 0;">
                    <Label style="-fx-text-fill: #555555; -fx-font-family: 'Courier New'; -fx-font-size: 15;" text="USUARIOS REGISTRADOS" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblConteo" style="-fx-text-fill: #444444; -fx-font-size: 15;" text="0 registros" />
                </HBox>
                <HBox spacing="15" style="-fx-padding: 10 15 10 15; -fx-border-color: #1e1e1e; -fx-border-width: 0 0 1 0;">
                    <Label prefWidth="110.0" style="-fx-text-fill: #444444; -fx-font-family: 'Courier New'; -fx-font-size: 15;" text="CÉDULA" />
                    <Label prefWidth="150" style="-fx-text-fill: #444444; -fx-font-family: 'Courier New'; -fx-font-size: 15;" text="NOMBRE" />
                    <Label prefWidth="200" style="-fx-text-fill: #444444; -fx-font-family: 'Courier New'; -fx-font-size: 15;" text="EMAIL" />
                    <Label prefWidth="110" style="-fx-text-fill: #444444; -fx-font-family: 'Courier New'; -fx-font-size: 15;" text="TELÉFONO" />
                    <Label prefWidth="80" style="-fx-text-fill: #444444; -fx-font-family: 'Courier New'; -fx-font-size: 15;" text="ESTADO" />
                    <Label style="-fx-text-fill: #444444; -fx-font-family: 'Courier New'; -fx-font-size: 15;" text="ACCIONES" />
                </HBox>
                <VBox fx:id="listaUsuarios" VBox.vgrow="ALWAYS" />
            </VBox>

            <VBox spacing="15" style="-fx-background-color: #161616; -fx-border-color: #252525; -fx-border-width: 1; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 20;">
                <Label style="-fx-text-fill: #e8c96d; -fx-font-family: 'Courier New'; -fx-border-color: #222222; -fx-border-width: 0 0 1 0; -fx-font-size: 20; -fx-padding: 0 0 10 0;" text="EDITAR / NUEVO USUARIO" />
                <HBox spacing="10">
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label style="-fx-text-fill: #555555; -fx-font-size: 15;" text="CÉDULA" />
                        <TextField fx:id="txtCedulaForm" editable="false" promptText="0102030405" style="-fx-background-color: #1a1a1a; -fx-border-color: #2e2e2e; -fx-border-width: 1; -fx-border-radius: 5; -fx-background-radius: 5; -fx-text-fill: #aaaaaa; -fx-prompt-text-fill: #3a3a3a; -fx-font-family: 'Courier New'; -fx-font-size: 15; -fx-padding: 5 10 5 10;" />
                    </VBox>
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label style="-fx-text-fill: #555555; -fx-font-size: 15;" text="NOMBRE" />
                        <TextField fx:id="txtNombreForm" promptText="Nombre completo" style="-fx-background-color: #1a1a1a; -fx-border-color: #2e2e2e; -fx-border-width: 1; -fx-border-radius: 5; -fx-background-radius: 5; -fx-text-fill: #aaaaaa; -fx-prompt-text-fill: #3a3a3a; -fx-font-size: 15; -fx-padding: 5 10 5 10;" />
                    </VBox>
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label style="-fx-text-fill: #555555; -fx-font-size: 15;" text="EMAIL" />
                        <TextField fx:id="txtEmailForm" promptText="correo@mail.com" style="-fx-background-color: #1a1a1a; -fx-border-color: #2e2e2e; -fx-border-width: 1; -fx-border-radius: 5; -fx-background-radius: 5; -fx-text-fill: #aaaaaa; -fx-prompt-text-fill: #3a3a3a; -fx-font-size: 15; -fx-padding: 5 10 5 10;" />
                    </VBox>
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label style="-fx-text-fill: #555555; -fx-font-size: 15;" text="TELÉFONO" />
                        <TextField fx:id="txtCelularForm" promptText="09XXXXXXXX" style="-fx-background-color: #1a1a1a; -fx-border-color: #2e2e2e; -fx-border-width: 1; -fx-border-radius: 5; -fx-background-radius: 5; -fx-text-fill: #aaaaaa; -fx-prompt-text-fill: #3a3a3a; -fx-font-family: 'Courier New'; -fx-font-size: 15; -fx-padding: 5 10 5 10;" />
                    </VBox>
                    <VBox spacing="5">
                        <Label style="-fx-text-fill: #555555; -fx-font-size: 15;" text="ESTADO" />
                        <ComboBox fx:id="cmbEstadoForm" prefWidth="110" promptText="Estado" style="-fx-background-color: #1a1a1a; -fx-border-color: #2e2e2e; -fx-border-width: 1; -fx-border-radius: 5; -fx-background-radius: 5; -fx-font-size: 15;" />
                    </VBox>
                </HBox>
                <HBox alignment="CENTER_RIGHT" spacing="10">
                    <Button fx:id="btnCancelar" onAction="#onCancelar" style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-border-color: #2a2a2a; -fx-border-width: 1; -fx-border-radius: 5; -fx-background-radius: 5; -fx-cursor: hand; -fx-font-size: 15; -fx-padding: 5 15 5 15;" text="Cancelar" />
                    <Button fx:id="btnGuardar" onAction="#onGuardar" style="-fx-background-color: #e8c96d; -fx-text-fill: #0f0f0f; -fx-font-weight: bold; -fx-border-radius: 5; -fx-background-radius: 5; -fx-cursor: hand; -fx-font-size: 15; -fx-padding: 5 15 5 15;" text="Guardar" />
                </HBox>
            </VBox>

            <VBox spacing="15" style="-fx-background-color: #161616; -fx-border-color: #252525; -fx-border-width: 1; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 20;">
                <Label style="-fx-text-fill: #e8c96d; -fx-font-family: 'Courier New'; -fx-border-color: #222222; -fx-border-width: 0 0 1 0; -fx-font-size: 20; -fx-padding: 0 0 10 0;" text="CONTRATAR SERVICIO" />
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                        <Label style="-fx-text-fill: #555555; -fx-font-size: 15;" text="CLIENTE" />
                        <Label fx:id="lblClienteContratar" style="-fx-text-fill: #aaaaaa; -fx-font-size: 15;" text="Selecciona un cliente con el botón Contratar de la lista" />
                    </VBox>
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label style="-fx-text-fill: #555555; -fx-font-size: 15;" text="SERVICIO" />
                        <ComboBox fx:id="cmbServicioContratar" maxWidth="Infinity" promptText="Selecciona servicio" style="-fx-background-color: #1a1a1a; -fx-border-color: #2e2e2e; -fx-border-width: 1; -fx-border-radius: 5; -fx-background-radius: 5; -fx-font-size: 15;" />
                    </VBox>
               <VBox>
                  <children>
                     <Region VBox.vgrow="ALWAYS" />
                          <Button fx:id="btnContratar" onAction="#onContratarServicio" style="-fx-background-color: #e8c96d; -fx-text-fill: #0f0f0f; -fx-font-weight: bold; -fx-border-radius: 5; -fx-background-radius: 5; -fx-cursor: hand; -fx-font-size: 15; -fx-padding: 5 15 5 15;" text="Contratar" />
                  </children>
               </VBox>
                </HBox>
            </VBox>

        </VBox>
    </center>

</BorderPane>
