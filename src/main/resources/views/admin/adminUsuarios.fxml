<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane prefWidth="1000" prefHeight="660"
            style="-fx-background-color: #0f0f0f;"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="servicart.ui.controllers.admin.AdminUsuariosController"
>

    <top>
        <HBox alignment="CENTER_LEFT"
              style="-fx-background-color: #161616; -fx-border-color: #222222; -fx-border-width: 0 0 1 0; -fx-padding: 11 20 11 20;">
            <Label text="SERVICART ADMIN"
                   style="-fx-text-fill: #e8c96d; -fx-font-size: 14; -fx-font-weight: bold; -fx-font-family: 'Courier New';"/>
        </HBox>
    </top>

    <left>
        <VBox prefWidth="150"
              style="-fx-background-color: #111111; -fx-border-color: #1e1e1e; -fx-border-width: 0 1 0 0;">
            <Label text="ADMIN"
                   style="-fx-text-fill: #e8c96d; -fx-font-size: 11; -fx-font-family: 'Courier New'; -fx-font-weight: bold; -fx-padding: 0 14 12 14; -fx-border-color: #1e1e1e; -fx-border-width: 0 0 1 0;"/>
            <Button fx:id="btnDashboard" onAction="#onDashboard" text="⊞ Dashboard" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-border-color: transparent; -fx-font-size: 11; -fx-padding: 8 14 8 14; -fx-alignment: center-left; -fx-cursor: hand;">
                <VBox.margin><Insets top="6"/></VBox.margin>
            </Button>
            <Button fx:id="btnUsuarios" onAction="#onUsuarios" text="👥 Usuarios" maxWidth="Infinity"
                    style="-fx-background-color: #1a1a0d; -fx-text-fill: #e8c96d; -fx-border-color: #e8c96d; -fx-border-width: 0 0 0 2; -fx-border-radius: 0; -fx-background-radius: 0; -fx-font-size: 11; -fx-padding: 8 14 8 12; -fx-alignment: center-left; -fx-cursor: hand;"/>
            <Button fx:id="btnTarifas" onAction="#onTarifas" text="⚙ Tarifas" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-border-color: transparent; -fx-font-size: 11; -fx-padding: 8 14 8 14; -fx-alignment: center-left; -fx-cursor: hand;"/>
            <Button fx:id="btnCortes" onAction="#onCortes" text="⚠ Cortes/mora" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-border-color: transparent; -fx-font-size: 11; -fx-padding: 8 14 8 14; -fx-alignment: center-left; -fx-cursor: hand;"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Button fx:id="btnSalir" onAction="#onSalir" text="⬅ Salir" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #c0392b; -fx-border-color: transparent; -fx-font-size: 11; -fx-padding: 8 14 8 14; -fx-alignment: center-left; -fx-cursor: hand;"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="12" style="-fx-background-color: #0f0f0f; -fx-padding: 16 18 18 18;">

            <!-- Búsqueda y acciones -->
            <HBox spacing="8" alignment="CENTER_LEFT">
                <TextField fx:id="txtBuscar" promptText="Buscar por cédula, nombre o email..."
                           HBox.hgrow="ALWAYS"
                           style="-fx-background-color: #1a1a1a; -fx-border-color: #2e2e2e; -fx-border-width: 1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-text-fill: #aaaaaa; -fx-prompt-text-fill: #3a3a3a; -fx-font-size: 12; -fx-padding: 7 12 7 12; -fx-font-family: 'Courier New';"/>
                <Button fx:id="btnNuevoUsuario" onAction="#onNuevoUsuario" text="+ Nuevo usuario"
                        style="-fx-background-color: #e8c96d; -fx-text-fill: #0f0f0f; -fx-font-size: 11; -fx-font-weight: bold; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 7 14 7 14; -fx-cursor: hand;"/>
                <Button text="Exportar"
                        style="-fx-background-color: transparent; -fx-text-fill: #e8c96d; -fx-border-color: #e8c96d; -fx-border-width: 1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 11; -fx-padding: 7 14 7 14; -fx-cursor: hand;"/>
            </HBox>

            <!-- Tabla usuarios -->
            <VBox VBox.vgrow="ALWAYS"
                  style="-fx-background-color: #161616; -fx-border-color: #222222; -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8;">
                <HBox alignment="CENTER_LEFT"
                      style="-fx-padding: 8 14 8 14; -fx-border-color: #222222; -fx-border-width: 0 0 1 0;">
                    <Label text="USUARIOS REGISTRADOS"
                           style="-fx-text-fill: #555555; -fx-font-size: 10; -fx-font-family: 'Courier New';"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblConteo" text="0 registros"
                           style="-fx-text-fill: #444444; -fx-font-size: 10;"/>
                </HBox>
                <TableView fx:id="tblUsuarios" VBox.vgrow="ALWAYS"
                           style="-fx-background-color: transparent; -fx-control-inner-background: #161616; -fx-table-cell-border-color: #1e1e1e;">
                    <columns>
                        <TableColumn fx:id="colCedula" text="CÉDULA"   prefWidth="110"/>
                        <TableColumn fx:id="colNombre" text="NOMBRE"   prefWidth="150"/>
                        <TableColumn fx:id="colEmail" text="EMAIL"    prefWidth="180"/>
                        <TableColumn fx:id="colTelefono" text="TELÉFONO" prefWidth="110"/>
                        <TableColumn fx:id="colEstado" text="ESTADO"   prefWidth="90"/>
                        <TableColumn fx:id="colAcciones" text="ACCIONES" prefWidth="160"/>
                    </columns>
                </TableView>
            </VBox>

            <!-- Formulario editar/nuevo -->
            <VBox style="-fx-background-color: #161616; -fx-border-color: #252525; -fx-border-width: 1; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 18;">
                <Label text="EDITAR / NUEVO USUARIO"
                       style="-fx-text-fill: #e8c96d; -fx-font-size: 11; -fx-font-family: 'Courier New'; -fx-border-color: #222222; -fx-border-width: 0 0 1 0; -fx-padding: 0 0 10 0;"/>
                <HBox spacing="12">
                    <VBox.margin><Insets top="14"/></VBox.margin>
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="CÉDULA" style="-fx-text-fill: #555555; -fx-font-size: 9;"/>
                        <TextField fx:id="txtCedulaForm" promptText="0102030405"
                                   style="-fx-background-color: #1a1a1a; -fx-border-color: #2e2e2e; -fx-border-width: 1; -fx-border-radius: 5; -fx-background-radius: 5; -fx-text-fill: #aaaaaa; -fx-prompt-text-fill: #3a3a3a; -fx-font-size: 12; -fx-padding: 7 9 7 9; -fx-font-family: 'Courier New';"/>
                    </VBox>
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="NOMBRE" style="-fx-text-fill: #555555; -fx-font-size: 9;"/>
                        <TextField fx:id="txtNombreForm" promptText="Nombre completo"
                                   style="-fx-background-color: #1a1a1a; -fx-border-color: #2e2e2e; -fx-border-width: 1; -fx-border-radius: 5; -fx-background-radius: 5; -fx-text-fill: #aaaaaa; -fx-prompt-text-fill: #3a3a3a; -fx-font-size: 12; -fx-padding: 7 9 7 9;"/>
                    </VBox>
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="EMAIL" style="-fx-text-fill: #555555; -fx-font-size: 9;"/>
                        <TextField fx:id="txtEmailForm" promptText="correo@mail.com"
                                   style="-fx-background-color: #1a1a1a; -fx-border-color: #2e2e2e; -fx-border-width: 1; -fx-border-radius: 5; -fx-background-radius: 5; -fx-text-fill: #aaaaaa; -fx-prompt-text-fill: #3a3a3a; -fx-font-size: 12; -fx-padding: 7 9 7 9;"/>
                    </VBox>
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="TELÉFONO" style="-fx-text-fill: #555555; -fx-font-size: 9;"/>
                        <TextField fx:id="txtCelularForm" promptText="09XXXXXXXX"
                                   style="-fx-background-color: #1a1a1a; -fx-border-color: #2e2e2e; -fx-border-width: 1; -fx-border-radius: 5; -fx-background-radius: 5; -fx-text-fill: #aaaaaa; -fx-prompt-text-fill: #3a3a3a; -fx-font-size: 12; -fx-padding: 7 9 7 9; -fx-font-family: 'Courier New';"/>
                    </VBox>
                    <VBox spacing="5">
                        <Label text="ESTADO" style="-fx-text-fill: #555555; -fx-font-size: 9;"/>
                        <ComboBox fx:id="cmbEstadoForm" promptText="Estado" prefWidth="110"
                                  style="-fx-background-color: #1a1a1a; -fx-border-color: #2e2e2e; -fx-border-width: 1; -fx-border-radius: 5; -fx-background-radius: 5; -fx-font-size: 12;"/>
                    </VBox>
                </HBox>
                <HBox spacing="8" alignment="CENTER_RIGHT">
                    <VBox.margin><Insets top="14"/></VBox.margin>
                    <Button fx:id="btnCancelar" onAction="#onCancelar" text="Cancelar"
                            style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-border-color: #2a2a2a; -fx-border-width: 1; -fx-border-radius: 5; -fx-background-radius: 5; -fx-font-size: 11; -fx-padding: 7 16 7 16; -fx-cursor: hand;"/>
                    <Button fx:id="btnGuardar" onAction="#onGuardar" text="Guardar"
                            style="-fx-background-color: #e8c96d; -fx-text-fill: #0f0f0f; -fx-font-size: 11; -fx-font-weight: bold; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 7 16 7 16; -fx-cursor: hand;"/>
                </HBox>
            </VBox>

        </VBox>
    </center>

</BorderPane>
