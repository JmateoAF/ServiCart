<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" style="-fx-background-color: #0f0f0f;"
            stylesheets="@../../assets/css/styles.css" xmlns="http://javafx.com/javafx/26"
            fx:controller="servicart.ui.controllers.admin.AdminTarifasController">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="70.0"
              style="-fx-background-color: #161616; -fx-border-color: #222222; -fx-border-width: 0 0 1 0; -fx-padding: 10 20 10 20;">
            <Label style="-fx-text-fill: #e8c96d; -fx-font-weight: bold; -fx-font-family: 'Courier New'; -fx-font-size: 25;"
                   text="SERVICART ADMIN"/>
        </HBox>
    </top>

    <left>
        <VBox prefWidth="200"
              style="-fx-background-color: #111111; -fx-border-color: #1e1e1e; -fx-border-width: 0 1 0 0;">
            <Region prefHeight="5" style="-fx-background-color: #1e1e1e; -fx-border-color: #1e1e1e;"/>
            <Button maxWidth="Infinity" onAction="#onUsuarios"
                    style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-border-color: transparent; -fx-font-size: 20; -fx-padding: 10 15 10 15; -fx-alignment: center-left; -fx-cursor: hand;"
                    text="Usuarios"/>
            <Button maxWidth="Infinity"
                    style="-fx-background-color: #1a1a0d; -fx-text-fill: #e8c96d; -fx-border-color: #e8c96d; -fx-border-width: 0 0 0 5; -fx-font-size: 20; -fx-padding: 10 15 10 10; -fx-alignment: center-left; -fx-cursor: hand;"
                    text="Tarifas"/>
            <Button maxWidth="Infinity" onAction="#onCortes"
                    style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-border-color: transparent; -fx-font-size: 20; -fx-padding: 10 15 10 15; -fx-alignment: center-left; -fx-cursor: hand;"
                    text="Cortes/mora"/>
            <Button maxWidth="Infinity" onAction="#onEmpresas"
                    style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-border-color: transparent; -fx-font-size: 20; -fx-padding: 10 15 10 15; -fx-alignment: center-left; -fx-cursor: hand;"
                    text="Empresas"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Separator style="-fx-background-color: #1e1e1e;"/>
            <Button maxWidth="Infinity" onAction="#onSalir"
                    style="-fx-background-color: transparent; -fx-text-fill: #c0392b; -fx-border-color: transparent; -fx-font-size: 20; -fx-padding: 10 15 10 15; -fx-alignment: center-left; -fx-cursor: hand;"
                    text="Salir"/>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background: #0f0f0f; -fx-background-color: #0f0f0f; -fx-border-color: transparent;">
            <VBox spacing="10" style="-fx-background-color: #0f0f0f; -fx-padding: 20;">

                <GridPane fx:id="gridTarifas" hgap="10" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                    </columnConstraints>
                </GridPane>

                <VBox spacing="15"
                      style="-fx-background-color: #161616; -fx-border-color: #252525; -fx-border-width: 1; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 20;">
                    <Label fx:id="lblFormularioTitulo"
                           style="-fx-text-fill: #e8c96d; -fx-font-family: 'Courier New'; -fx-border-color: #222222; -fx-border-width: 0 0 1 0; -fx-font-size: 20; -fx-padding: 0 0 10 0;"
                           text="EDITAR TARIFA"/>
                    <HBox spacing="10">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label style="-fx-text-fill: #555555; -fx-font-size: 15;" text="TARIFA BASE"/>
                            <TextField fx:id="txtTarifaBase" promptText="0.00"
                                       style="-fx-background-color: #1a1a1a; -fx-border-color: #2e2e2e; -fx-border-width: 1; -fx-border-radius: 5; -fx-background-radius: 5; -fx-text-fill: #aaaaaa; -fx-font-family: 'Courier New'; -fx-font-size: 15; -fx-padding: 5 10 5 10;"/>
                        </VBox>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label style="-fx-text-fill: #555555; -fx-font-size: 15;" text="INTERÉS MORA DIARIO (%)"/>
                            <TextField fx:id="txtInteresMora" promptText="0.00"
                                       style="-fx-background-color: #1a1a1a; -fx-border-color: #2e2e2e; -fx-border-width: 1; -fx-border-radius: 5; -fx-background-radius: 5; -fx-text-fill: #aaaaaa; -fx-font-family: 'Courier New'; -fx-font-size: 15; -fx-padding: 5 10 5 10;"/>
                        </VBox>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label style="-fx-text-fill: #555555; -fx-font-size: 15;" text="DÍAS PARA CORTE"/>
                            <TextField fx:id="txtDiasCorte" promptText="15"
                                       style="-fx-background-color: #1a1a1a; -fx-border-color: #2e2e2e; -fx-border-width: 1; -fx-border-radius: 5; -fx-background-radius: 5; -fx-text-fill: #aaaaaa; -fx-font-family: 'Courier New'; -fx-font-size: 15; -fx-padding: 5 10 5 10;">
                                <tooltip>
                                    <Tooltip
                                            text="Días entre la fecha de vencimiento y el corte del servicio. Solo aplica a facturas emitidas después de guardar este cambio."/>
                                </tooltip>
                            </TextField>
                        </VBox>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label style="-fx-text-fill: #555555; -fx-font-size: 15;" text="COSTO REACTIVACIÓN ($)"/>
                            <TextField fx:id="txtCostoReactivacion" promptText="0.00"
                                       style="-fx-background-color: #1a1a1a; -fx-border-color: #2e2e2e; -fx-border-width: 1; -fx-border-radius: 5; -fx-background-radius: 5; -fx-text-fill: #aaaaaa; -fx-font-family: 'Courier New'; -fx-font-size: 15; -fx-padding: 5 10 5 10;"/>
                        </VBox>
                    </HBox>
                    <HBox alignment="CENTER_RIGHT" spacing="10">
                        <Button onAction="#onCancelar"
                                style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-border-color: #2a2a2a; -fx-border-width: 1; -fx-border-radius: 5; -fx-background-radius: 5; -fx-cursor: hand; -fx-font-size: 15; -fx-padding: 5 15 5 15;"
                                text="Cancelar"/>
                        <Button onAction="#onGuardar"
                                style="-fx-background-color: #e8c96d; -fx-text-fill: #0f0f0f; -fx-font-weight: bold; -fx-border-radius: 5; -fx-background-radius: 5; -fx-cursor: hand; -fx-font-size: 15; -fx-padding: 5 15 5 15;"
                                text="Guardar"/>
                    </HBox>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
