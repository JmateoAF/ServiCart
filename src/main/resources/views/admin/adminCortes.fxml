<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane style="-fx-background-color: #0f0f0f;" stylesheets="@../../assets/css/styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="servicart.ui.controllers.admin.AdminCortesController">

    <top>
        <HBox alignment="CENTER_LEFT" style="-fx-background-color: #161616; -fx-border-color: #222222; -fx-border-width: 0 0 1 0; -fx-padding: 10 20 10 20;">
            <Label style="-fx-text-fill: #e8c96d; -fx-font-weight: bold; -fx-font-family: 'Courier New'; -fx-font-size: 25;" text="SERVICART ADMIN" />
         <Region HBox.hgrow="ALWAYS" />

             <HBox style="-fx-border-color: #2a2a2a; -fx-border-width: 1; -fx-border-radius: 5; -fx-background-radius: 5;">
                 <Button fx:id="btnSQLite" onAction="#onSeleccionarSQLite" style="-fx-background-color: #1e1c0f; -fx-text-fill: #e8c96d; -fx-border-color: transparent; -fx-cursor: hand; -fx-background-radius: 5; -fx-font-size: 20; -fx-padding: 5 15 5 15;" text="SQLite" />
                 <Button fx:id="btnBinario" onAction="#onSeleccionarBinario" style="-fx-background-color: #161616; -fx-text-fill: #555555; -fx-border-color: transparent; -fx-cursor: hand; -fx-background-radius: 5; -fx-font-size: 20; -fx-padding: 5 15 5 15;" text="Archivos binarios" />
             </HBox>
        </HBox>
    </top>

    <left>
        <VBox prefWidth="200" style="-fx-background-color: #111111; -fx-border-color: #1e1e1e; -fx-border-width: 0 1 0 0;">
            <Region prefHeight="5" style="-fx-background-color: #1e1e1e; -fx-border-color: #1e1e1e;" />
            <Button fx:id="btnUsuarios" maxWidth="Infinity" onAction="#onUsuarios" style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-border-color: transparent; -fx-font-size: 20; -fx-padding: 10 15 10 15; -fx-alignment: center-left; -fx-cursor: hand;" text="Usuarios" />
            <Button fx:id="btnTarifas" maxWidth="Infinity" onAction="#onTarifas" style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-border-color: transparent; -fx-font-size: 20; -fx-padding: 10 15 10 15; -fx-alignment: center-left; -fx-cursor: hand;" text="Tarifas" />
            <Button fx:id="btnCortes" maxWidth="Infinity" onAction="#onCortes" style="-fx-background-color: #1a1a0d; -fx-text-fill: #e8c96d; -fx-border-color: #e8c96d; -fx-border-width: 0 0 0 5; -fx-font-size: 20; -fx-padding: 10 15 10 10; -fx-alignment: center-left; -fx-cursor: hand;" text="Cortes/mora" />
            <Button fx:id="btnEmpresas" maxWidth="Infinity" onAction="#onEmpresas" style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-border-color: transparent; -fx-font-size: 20; -fx-padding: 10 15 10 15; -fx-alignment: center-left; -fx-cursor: hand;" text="Empresas" />
            <Region VBox.vgrow="ALWAYS" />
         <Separator style="-fx-background-color: #1e1e1e;" />
            <Button fx:id="btnSalir" maxWidth="Infinity" onAction="#onSalir" style="-fx-background-color: transparent; -fx-text-fill: #c0392b; -fx-border-color: transparent; -fx-font-size: 20; -fx-padding: 10 15 10 15; -fx-alignment: center-left; -fx-cursor: hand;" text="Salir" />
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background: #0f0f0f; -fx-background-color: #0f0f0f; -fx-border-color: transparent;">
            <VBox spacing="10" style="-fx-background-color: #0f0f0f; -fx-padding: 20;">

                <HBox spacing="10">
                    <VBox style="-fx-background-color: #161616; -fx-border-color: #222222; -fx-border-width: 1; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 10;" HBox.hgrow="ALWAYS">
                        <Label style="-fx-text-fill: #555555; -fx-font-size: 15;" text="SERVICIOS CORTADOS" />
                        <Label fx:id="lblServiciosCortados" style="-fx-text-fill: #c0392b; -fx-font-family: 'Courier New'; -fx-font-weight: bold; -fx-font-size: 20;" text="0" />
                    </VBox>
                    <VBox style="-fx-background-color: #161616; -fx-border-color: #222222; -fx-border-width: 1; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 10;" HBox.hgrow="ALWAYS">
                        <Label style="-fx-text-fill: #555555; -fx-font-size: 15;" text="EN MORA (sin corte)" />
                        <Label fx:id="lblEnMora" style="-fx-text-fill: #e07b39; -fx-font-family: 'Courier New'; -fx-font-weight: bold; -fx-font-size: 20;" text="0" />
                    </VBox>
                    <VBox style="-fx-background-color: #161616; -fx-border-color: #222222; -fx-border-width: 1; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 10;" HBox.hgrow="ALWAYS">
                        <Label style="-fx-text-fill: #555555; -fx-font-size: 15;" text="INTERESES GENERADOS" />
                        <Label fx:id="lblInteresesGenerados" style="-fx-text-fill: #e8c96d; -fx-font-family: 'Courier New'; -fx-font-weight: bold; -fx-font-size: 20;" text="0.00" />
                    </VBox>
                </HBox>

                <HBox maxWidth="-Infinity" style="-fx-border-color: #2a2a2a; -fx-border-width: 1; -fx-border-radius: 5; -fx-background-radius: 5;">
                    <Button fx:id="btnVerMora" onAction="#onVerMora" style="-fx-background-color: #1e1c0f; -fx-text-fill: #e8c96d; -fx-border-color: transparent; -fx-cursor: hand; -fx-background-radius: 5 0 0 5; -fx-font-size: 15; -fx-padding: 5 15 5 15;" text="Con mora" />
                    <Button fx:id="btnVerCortados" onAction="#onVerCortados" style="-fx-background-color: #161616; -fx-text-fill: #555555; -fx-border-color: transparent; -fx-cursor: hand; -fx-background-radius: 0 5 5 0; -fx-font-size: 15; -fx-padding: 5 15 5 15;" text="Cortados" />
                </HBox>

                <VBox fx:id="contenedorTarjetas" spacing="10" />

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
