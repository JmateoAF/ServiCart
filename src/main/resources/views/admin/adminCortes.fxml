<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefWidth="1000" prefHeight="660"
            style="-fx-background-color: #0f0f0f;"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="servicart.ui.controllers.admin.AdminCortesController">

    <top>
        <HBox alignment="CENTER_LEFT"
              style="-fx-background-color: #161616; -fx-border-color: #222222; -fx-border-width: 0 0 1 0; -fx-padding: 10 20 10 20;">
            <Label text="SERVICART ADMIN"
                   style="-fx-text-fill: #e8c96d; -fx-font-weight: bold; -fx-font-family: 'Courier New'; -fx-font-size: 25;"/>
        </HBox>
    </top>

    <left>
        <VBox prefWidth="200"
              style="-fx-background-color: #111111; -fx-border-color: #1e1e1e; -fx-border-width: 0 1 0 0;">
            <Label text="ADMIN"
                   style="-fx-text-fill: #e8c96d; -fx-font-family: 'Courier New'; -fx-font-weight: bold; -fx-border-color: #1e1e1e; -fx-border-width: 0 0 1 0; -fx-font-size: 20; -fx-padding: 0 15 10 15;"/>
            <Region prefHeight="5"/>
            <Button fx:id="btnDashboard" onAction="#onDashboard" text="⊞ Dashboard" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-border-color: transparent; -fx-alignment: center-left; -fx-cursor: hand; -fx-font-size: 20; -fx-padding: 10 15 10 15;"/>
            <Button fx:id="btnUsuarios" onAction="#onUsuarios" text="👥 Usuarios" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-border-color: transparent; -fx-alignment: center-left; -fx-cursor: hand; -fx-font-size: 20; -fx-padding: 10 15 10 15;"/>
            <Button fx:id="btnTarifas" onAction="#onTarifas" text="⚙ Tarifas" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-border-color: transparent; -fx-alignment: center-left; -fx-cursor: hand; -fx-font-size: 20; -fx-padding: 10 15 10 15;"/>
            <Button fx:id="btnCortes" onAction="#onCortes" text="⚠ Cortes/mora" maxWidth="Infinity"
                    style="-fx-background-color: #1a1a0d; -fx-text-fill: #e8c96d; -fx-border-color: #e8c96d; -fx-border-width: 0 0 0 2; -fx-border-radius: 0; -fx-background-radius: 0; -fx-alignment: center-left; -fx-cursor: hand; -fx-font-size: 20; -fx-padding: 10 15 10 10;"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Button fx:id="btnSalir" onAction="#onSalir" text="⬅ Salir" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #c0392b; -fx-border-color: transparent; -fx-alignment: center-left; -fx-cursor: hand; -fx-font-size: 20; -fx-padding: 10 15 10 15;"/>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background: #0f0f0f; -fx-background-color: #0f0f0f; -fx-border-color: transparent;">
            <VBox spacing="10" style="-fx-background-color: #0f0f0f; -fx-padding: 15 20 20 20;">

                <!-- Stats resumen: calculados en tiempo real en AdminCortesController -->
                <HBox spacing="10">
                    <VBox HBox.hgrow="ALWAYS"
                          style="-fx-background-color: #161616; -fx-border-color: #222222; -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10;">
                        <Label text="SERVICIOS CORTADOS" style="-fx-text-fill: #555555; -fx-font-size: 15;"/>
                        <Label fx:id="lblServiciosCortados" text="0" style="-fx-text-fill: #c0392b; -fx-font-family: 'Courier New'; -fx-font-weight: bold; -fx-font-size: 20;"/>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS"
                          style="-fx-background-color: #161616; -fx-border-color: #222222; -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10;">
                        <Label text="EN MORA (sin corte)" style="-fx-text-fill: #555555; -fx-font-size: 15;"/>
                        <Label fx:id="lblEnMora" text="0" style="-fx-text-fill: #e07b39; -fx-font-family: 'Courier New'; -fx-font-weight: bold; -fx-font-size: 20;"/>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS"
                          style="-fx-background-color: #161616; -fx-border-color: #222222; -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10;">
                        <Label text="INTERESES GENERADOS" style="-fx-text-fill: #555555; -fx-font-size: 15;"/>
                        <Label fx:id="lblInteresesGenerados" text="0.00" style="-fx-text-fill: #e8c96d; -fx-font-family: 'Courier New'; -fx-font-weight: bold; -fx-font-size: 20;"/>
                    </VBox>
                </HBox>

                <!-- Toggle Con mora / Cortados -->
                <HBox style="-fx-border-color: #2a2a2a; -fx-border-width: 1; -fx-border-radius: 6;" maxWidth="220">
                    <Button fx:id="btnVerMora" onAction="#onVerMora" text="Con mora"
                            style="-fx-background-color: #1e1c0f; -fx-text-fill: #e8c96d; -fx-border-color: transparent; -fx-cursor: hand; -fx-background-radius: 5 0 0 5; -fx-font-size: 15; -fx-padding: 5 15 5 15;"/>
                    <Button fx:id="btnVerCortados" onAction="#onVerCortados" text="Cortados"
                            style="-fx-background-color: #161616; -fx-text-fill: #555555; -fx-border-color: transparent; -fx-cursor: hand; -fx-background-radius: 0 5 5 0; -fx-font-size: 15; -fx-padding: 5 15 5 15;"/>
                </HBox>

                <!-- Tarjetas dinámicas: en mora sin corte, o cortados, según el toggle -->
                <VBox fx:id="contenedorTarjetas" spacing="10"/>

                <!-- Tabla historial: combina siempre ambas listas, sin importar el toggle -->
                <VBox style="-fx-background-color: #161616; -fx-border-color: #222222; -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8;">
                    <HBox alignment="CENTER_LEFT"
                          style="-fx-padding: 10 15 10 15; -fx-border-color: #222222; -fx-border-width: 0 0 1 0;">
                        <Label text="HISTORIAL DE CORTES Y MORA"
                               style="-fx-text-fill: #555555; -fx-font-family: 'Courier New'; -fx-font-size: 15;"/>
                    </HBox>
                    <TableView fx:id="tblHistorial" prefHeight="160"
                               style="-fx-background-color: transparent; -fx-control-inner-background: #161616; -fx-table-cell-border-color: #1e1e1e;">
                        <columns>
                            <TableColumn fx:id="colUsuario" text="USUARIO"    prefWidth="150"/>
                            <TableColumn fx:id="colServicio" text="SERVICIO"   prefWidth="130"/>
                            <TableColumn fx:id="colDiasMora" text="DÍAS MORA"  prefWidth="90"/>
                            <TableColumn fx:id="colInteres" text="INTERÉS"    prefWidth="90"/>
                            <TableColumn fx:id="colEstado" text="ESTADO"     prefWidth="100"/>
                            <TableColumn fx:id="colAcciones" text="ACCIONES"   prefWidth="140"/>
                        </columns>
                    </TableView>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
