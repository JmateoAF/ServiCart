<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane prefWidth="1000" prefHeight="660" style="-fx-background-color: #0f0f0f;" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
    <top>
        <HBox alignment="CENTER_LEFT"
              style="-fx-background-color: #161616; -fx-border-color: #222222; -fx-border-width: 0 0 1 0; -fx-padding: 11 20 11 20;">
            <Label text="SERVICART ADMIN"
                   style="-fx-text-fill: #e8c96d; -fx-font-size: 14; -fx-font-weight: bold; -fx-font-family: 'Courier New';"/>
        </HBox>
    </top>

    <left>
        <VBox prefWidth="150"
              style="-fx-background-color: #111111; -fx-border-color: #1e1e1e; -fx-border-width: 0 1 0 0;">

            <Label text="ADMIN"
                   style="-fx-text-fill: #e8c96d; -fx-font-size: 11; -fx-font-family: 'Courier New'; -fx-font-weight: bold; -fx-padding: 0 14 12 14; -fx-border-color: #1e1e1e; -fx-border-width: 0 0 1 0;"/>

            <Button text="⊞ Dashboard" maxWidth="Infinity"
                    style="-fx-background-color: #1a1a0d; -fx-text-fill: #e8c96d; -fx-border-color: #e8c96d; -fx-border-width: 0 0 0 2; -fx-border-radius: 0; -fx-background-radius: 0; -fx-font-size: 11; -fx-padding: 8 14 8 12; -fx-alignment: center-left; -fx-cursor: hand;">
                <VBox.margin><Insets top="6"/></VBox.margin>
            </Button>
            <Button text="Usuarios" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-border-color: transparent; -fx-font-size: 11; -fx-padding: 8 14 8 14; -fx-alignment: center-left; -fx-cursor: hand;"/>
            <Button text="⚙ Tarifas" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-border-color: transparent; -fx-font-size: 11; -fx-padding: 8 14 8 14; -fx-alignment: center-left; -fx-cursor: hand;"/>
            <Button text="⚠ Cortes/mora" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-border-color: transparent; -fx-font-size: 11; -fx-padding: 8 14 8 14; -fx-alignment: center-left; -fx-cursor: hand;"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Button text="⬅ Salir" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #c0392b; -fx-border-color: transparent; -fx-font-size: 11; -fx-padding: 8 14 8 14; -fx-alignment: center-left; -fx-cursor: hand;"/>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background: #0f0f0f; -fx-background-color: #0f0f0f; -fx-border-color: transparent;">
            <VBox spacing="14"
                  style="-fx-background-color: #0f0f0f; -fx-padding: 16 18 18 18;">

                <!-- Toggle SQLite / Binario -->
                <HBox style="-fx-border-color: #2a2a2a; -fx-border-width: 1; -fx-border-radius: 6; -fx-background-radius: 6;" maxWidth="260">
                    <Button text="⬡  SQLite"
                            style="-fx-background-color: #1e1c0f; -fx-text-fill: #e8c96d; -fx-border-color: transparent; -fx-font-size: 11; -fx-padding: 6 16 6 16; -fx-cursor: hand; -fx-background-radius: 5 0 0 5;"/>
                    <Button text="≡  Archivos binarios"
                            style="-fx-background-color: #161616; -fx-text-fill: #555555; -fx-border-color: transparent; -fx-font-size: 11; -fx-padding: 6 16 6 16; -fx-cursor: hand; -fx-background-radius: 0 5 5 0;"/>
                </HBox>

                <!-- Stat cards -->
                <HBox spacing="8">
                    <VBox HBox.hgrow="ALWAYS"
                          style="-fx-background-color: #161616; -fx-border-color: #222222; -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10;">
                        <Label text="USUARIOS ACTIVOS" style="-fx-text-fill: #555555; -fx-font-size: 9;"/>
                        <Label text="142" style="-fx-text-fill: #e8c96d; -fx-font-size: 22; -fx-font-family: 'Courier New'; -fx-font-weight: bold;"/>
                        <Label text="↑ 3 este mes" style="-fx-text-fill: #444444; -fx-font-size: 9;"/>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS"
                          style="-fx-background-color: #161616; -fx-border-color: #222222; -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10;">
                        <Label text="CORTADOS" style="-fx-text-fill: #555555; -fx-font-size: 9;"/>
                        <Label text="17" style="-fx-text-fill: #c0392b; -fx-font-size: 22; -fx-font-family: 'Courier New'; -fx-font-weight: bold;"/>
                        <Label text="requieren atención" style="-fx-text-fill: #444444; -fx-font-size: 9;"/>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS"
                          style="-fx-background-color: #161616; -fx-border-color: #222222; -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10;">
                        <Label text="CON MORA" style="-fx-text-fill: #555555; -fx-font-size: 9;"/>
                        <Label text="34" style="-fx-text-fill: #e07b39; -fx-font-size: 22; -fx-font-family: 'Courier New'; -fx-font-weight: bold;"/>
                        <Label text="facturas vencidas" style="-fx-text-fill: #444444; -fx-font-size: 9;"/>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS"
                          style="-fx-background-color: #161616; -fx-border-color: #222222; -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10;">
                        <Label text="RECAUDADO" style="-fx-text-fill: #555555; -fx-font-size: 9;"/>
                        <Label text="4.2k" style="-fx-text-fill: #e8c96d; -fx-font-size: 22; -fx-font-family: 'Courier New'; -fx-font-weight: bold;"/>
                        <Label text="este mes" style="-fx-text-fill: #444444; -fx-font-size: 9;"/>
                    </VBox>
                </HBox>

                <VBox style="-fx-background-color: #161616; -fx-border-color: #222222; -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8;">
                    <HBox alignment="CENTER_LEFT"
                          style="-fx-padding: 8 12 8 12; -fx-border-color: #222222; -fx-border-width: 0 0 1 0;">
                        <Label text="USUARIOS — SQLite"
                               style="-fx-text-fill: #555555; -fx-font-size: 10; -fx-font-family: 'Courier New';"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="+ Nuevo"
                                style="-fx-background-color: #1c2a1c; -fx-text-fill: #4caf50; -fx-border-color: #2a3e2a; -fx-border-width: 1; -fx-border-radius: 4; -fx-background-radius: 4; -fx-font-size: 10; -fx-padding: 3 8 3 8; -fx-cursor: hand;"/>
                    </HBox>
                    <TableView prefHeight="170"
                               style="-fx-background-color: transparent; -fx-control-inner-background: #161616; -fx-table-cell-border-color: #1e1e1e;">
                        <columns>
                            <TableColumn text="CÉDULA"   prefWidth="110"/>
                            <TableColumn text="NOMBRE"   prefWidth="140"/>
                            <TableColumn text="EMAIL"    prefWidth="170"/>
                            <TableColumn text="ESTADO"   prefWidth="90"/>
                            <TableColumn text="ACCIONES" prefWidth="140"/>
                        </columns>
                    </TableView>
                </VBox>

                <VBox style="-fx-background-color: #161616; -fx-border-color: #222222; -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8;">
                    <HBox alignment="CENTER_LEFT"
                          style="-fx-padding: 8 12 8 12; -fx-border-color: #222222; -fx-border-width: 0 0 1 0;">
                        <Label text="TARIFAS — SQLite"
                               style="-fx-text-fill: #555555; -fx-font-size: 10; -fx-font-family: 'Courier New';"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Editar tarifas"
                                style="-fx-background-color: #1c2a1c; -fx-text-fill: #4caf50; -fx-border-color: #2a3e2a; -fx-border-width: 1; -fx-border-radius: 4; -fx-background-radius: 4; -fx-font-size: 10; -fx-padding: 3 8 3 8; -fx-cursor: hand;"/>
                    </HBox>
                    <TableView prefHeight="150"
                               style="-fx-background-color: transparent; -fx-control-inner-background: #161616; -fx-table-cell-border-color: #1e1e1e;">
                        <columns>
                            <TableColumn text="SERVICIO" prefWidth="130"/>
                            <TableColumn text="EMPRESA"  prefWidth="130"/>
                            <TableColumn text="TARIFA"   prefWidth="120"/>
                            <TableColumn text="TIPO"     prefWidth="100"/>
                            <TableColumn text=""         prefWidth="80"/>
                        </columns>
                    </TableView>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
