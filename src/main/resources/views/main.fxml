<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="30" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="servicart.controllers.MainController">
    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <Label text="Mi Aplicación" style="-fx-font-size: 32px; -fx-font-weight: bold;"/>

    <Button text="Sobre Nosotros" onAction="#irASobreNosotros" prefWidth="180" prefHeight="40"
            style="-fx-font-size: 16px;"/>
</VBox>