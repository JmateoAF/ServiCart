<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="500.0" minWidth="700.0" prefHeight="600.0" prefWidth="1000.0" style="-fx-background-color: #0f0f0f;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="servicart.ui.MainController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: #161616; -fx-border-color: #222222; -fx-border-width: 0 0 1 0; -fx-padding: 12 20 12 20;">
            <Label style="-fx-text-fill: #e8c96d; -fx-font-size: 15; -fx-font-weight: bold; -fx-font-family: 'Courier New';" text="SERVICART" />
            <Region HBox.hgrow="ALWAYS" />
            <Button style="-fx-background-color: #1f1f1f; -fx-text-fill: #e8c96d; -fx-border-color: #2a2a2a; -fx-border-width: 1; -fx-border-radius: 4; -fx-background-radius: 4; -fx-font-size: 12; -fx-padding: 5 14 5 14; -fx-cursor: hand;" text="inicio" />
            <Button onAction="#irASobreNosotros" style="-fx-background-color: transparent; -fx-text-fill: #666666; -fx-border-color: transparent; -fx-font-size: 12; -fx-padding: 5 14 5 14; -fx-cursor: hand;" text="sobre nosotros" />
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="10" style="-fx-background-color: #0f0f0f;">
            <VBox alignment="CENTER" spacing="6">
                <Label style="-fx-text-fill: #e8c96d; -fx-font-size: 28; -fx-font-weight: bold; -fx-font-family: 'Courier New';" text="SERVICART" />
                <Label style="-fx-text-fill: #444444; -fx-font-size: 12;" text="plataforma de pago de servicios básicos" />
            </VBox>

            <VBox maxWidth="380" spacing="10">
                <VBox.margin>
                    <Insets top="22" />
                </VBox.margin>

                <TextField promptText="Ingrese cédula o número de contrato..." style="-fx-background-color: #1a1a1a; -fx-border-color: #2e2e2e; -fx-border-width: 1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-text-fill: #cccccc; -fx-prompt-text-fill: #3a3a3a; -fx-font-size: 14; -fx-padding: 12 16 12 16;" />
                <Button maxWidth="Infinity" style="-fx-background-color: #e8c96d; -fx-text-fill: #0f0f0f; -fx-font-size: 14; -fx-font-weight: bold; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 12 0 12 0; -fx-cursor: hand;" text="BUSCAR DEUDAS" />
            </VBox>
        </VBox>
    </center>
</BorderPane>
