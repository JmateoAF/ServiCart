<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="servicart.ui.controllers.LoginClienteController">
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="55" style="-fx-background-color: #161616; -fx-border-color: #222222; -fx-border-width: 0 0 1 0;">
            <Label style="-fx-text-fill: #e8c96d; -fx-font-weight: bold; -fx-font-family: 'Courier New';" text="SERVICART">
            <font>
               <Font size="20.0" />
            </font></Label>
            <Region HBox.hgrow="ALWAYS" />
            <Button style="-fx-background-color: #1f1f1f; -fx-text-fill: #e8c96d; -fx-border-color: #2a2a2a; -fx-border-width: 1; -fx-border-radius: 4; -fx-background-radius: 4; -fx-font-size: 12; fx-padding: 5 14 5 14; -fx-cursor: hand;" text="Inicio" />
            <Button onAction="#irASobreNosotros" style="-fx-background-color: transparent; -fx-text-fill: #666666; -fx-border-color: transparent; -fx-font-size: 12; -fx-padding: 5 14 5 14;-fx-cursor: hand;" text="Sobre Nosotros">
                <HBox.margin>
                    <Insets left="8" />
                </HBox.margin>
            </Button>
         <padding>
            <Insets bottom="11.0" left="20.0" right="20.0" top="11.0" />
         </padding>
        </HBox>
    </top>

    <center>
        <StackPane style="-fx-background-color: #0f0f0f;">
            <VBox alignment="CENTER_LEFT" maxHeight="-Infinity" maxWidth="-Infinity" prefWidth="350" style="-fx-background-color: #161616; -fx-border-color: #252525; -fx-border-width: 1; -fx-border-radius: 10;-fx-background-radius: 10;-fx-padding: 28;">

                <Label maxWidth="Infinity" style="-fx-text-fill: #27ae60; -fx-background-color: #0f2a18; -fx-font-size: 15; -fx-font-family: 'Courier New'; -fx-alignment: center; -fx-background-radius: 4; -fx-padding: 5 0 5 0;" text="ACCESO CLIENTE">
                    <VBox.margin>
                        <Insets bottom="24" />
                    </VBox.margin>
                </Label>

                <Label style="-fx-text-fill: #555555; -fx-font-size: 10;" text="CÉDULA" />
                <TextField fx:id="txtCedula" promptText="0102030405" style="-fx-background-color: #1a1a1a; -fx-border-color: #2e2e2e; -fx-border-width: 1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-text-fill: #aaaaaa; -fx-prompt-text-fill: #3a3a3a; -fx-font-size: 15; -fx-padding: 8 10 8 10; -fx-font-family: 'Courier New';">
                    <VBox.margin>
                        <Insets bottom="16" top="5" />
                    </VBox.margin>
                </TextField>

                <Label style="-fx-text-fill: #555555; -fx-font-size: 10;" text="BASE DE DATOS" />
                <ComboBox fx:id="cmbBaseDatos" maxWidth="Infinity" style="-fx-background-color: #1a1a1a; -fx-border-color: #2e2e2e; -fx-border-width: 1; fx-border-radius: 6; -fx-background-radius: 6;">
                    <VBox.margin>
                        <Insets bottom="16" top="5" />
                    </VBox.margin>
                </ComboBox>

                <Label fx:id="lblError" managed="false" maxWidth="Infinity" style="-fx-text-fill: #c0392b; -fx-background-color: #2a1010; -fx-font-size: 11; -fx-padding: 7 10 7 10; -fx-background-radius: 4;" visible="false" wrapText="true">
                    <VBox.margin>
                        <Insets bottom="10" />
                    </VBox.margin>
                </Label>

                <Button fx:id="btnBuscar" maxWidth="Infinity" onAction="#onBuscarDeudas" style="-fx-background-color: #e8c96d; -fx-text-fill: #0f0f0f; -fx-font-size: 12; -fx-font-weight: bold; -fx-font-family: 'Courier New'; -fx-border-radius: 6; -fx-background-radius: 6;-fx-padding: 10 0 10 0; -fx-cursor: hand;" text="BUSCAR MIS DEUDAS">
                    <VBox.margin>
                        <Insets top="6" />
                    </VBox.margin>
                </Button>

                <Separator>
                    <VBox.margin>
                        <Insets bottom="14" top="18" />
                    </VBox.margin>
                </Separator>

                <Button maxWidth="Infinity" onAction="#irALoginAdmin" style="-fx-background-color: transparent; -fx-text-fill: #444444; -fx-font-size: 10; -fx-alignment: center; -fx-cursor: hand; -fx-border-color: transparent; -fx-padding: 0;" text="Soy administrador" />
            </VBox>
        </StackPane>
    </center>

</BorderPane>
