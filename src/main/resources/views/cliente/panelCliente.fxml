<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane style="-fx-background-color: #0f0f0f;" stylesheets="@../../assets/css/styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="servicart.ui.controllers.PanelClienteController">
    <left>
        <VBox prefWidth="200.0" style="-fx-background-color: #111111; -fx-border-color: #1e1e1e; -fx-border-width: 0 1 0 0;">
             <Label maxWidth="Infinity" style="-fx-text-fill: #e8c96d; -fx-font-size: 25; -fx-font-weight: bold; -fx-font-family: 'Courier New'; -fx-border-color: #1e1e1e; -fx-border-width: 0 0 5 0;" text="SERVICART">
            <padding>
               <Insets bottom="15.0" left="20.0" right="15.0" top="15.0" />
            </padding>
         </Label>

            <Button maxWidth="Infinity" style="-fx-background-color: #1a1a0d; -fx-text-fill: #e8c96d; -fx-border-color: #e8c96d; -fx-border-width: 0 0 0 5; -fx-font-size: 20; -fx-padding: 10 15 10 10; -fx-alignment: center-left; -fx-cursor: hand;" text="Mis servicios" />

            <Button fx:id="btnCarrito" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-border-color: transparent; -fx-font-size: 20; -fx-padding: 10 15 10 15; -fx-alignment: center-left; -fx-cursor: hand;" text="Carrito" />

            <Button fx:id="btnPerfil" maxWidth="Infinity" onAction="#onPerfil" style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-border-color: transparent; -fx-font-size: 20; -fx-padding: 10 15 10 15; -fx-alignment: center-left; -fx-cursor: hand;" text="Perfil" />

            <Region VBox.vgrow="ALWAYS" />
            <Separator style="-fx-background-color: #1e1e1e;" />

            <Button maxWidth="Infinity" onAction="#onSalir" style="-fx-background-color: transparent; -fx-text-fill: #c0392b; -fx-border-color: transparent; -fx-font-size: 20; -fx-padding: 10 15 10 15; -fx-alignment: center-left; -fx-cursor: hand;" text=" Salir">
                <VBox.margin>
                    <Insets bottom="6" />
                </VBox.margin>
            </Button>
        </VBox>
    </left>

    <center>
        <VBox style="-fx-background-color: #0f0f0f; -fx-padding: 20;">
            <HBox alignment="CENTER_LEFT">
                <Label style="-fx-text-fill: #e8c96d; -fx-font-size: 25; -fx-font-weight: bold; -fx-font-family: 'Courier New';" text="Mis Servicios" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="lblMensaje" style="-fx-text-fill: #555555; -fx-font-size: 25;" />
            </HBox>
            <Separator style="-fx-background-color: #1e1e1e;">
                <VBox.margin>
                    <Insets bottom="15.0" top="10.0" />
                </VBox.margin>
            </Separator>

            <ScrollPane fitToWidth="true" style="-fx-background: #0f0f0f; -fx-background-color: #0f0f0f; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                <VBox fx:id="contenedorServicios" spacing="10">
                    <padding>
                        <Insets bottom="15.0" />
                    </padding>
                </VBox>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>
