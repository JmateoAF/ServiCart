<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" prefHeight="640"
            prefWidth="960"
            style="-fx-background-color: #0f0f0f;"
            xmlns="http://javafx.com/javafx/26"
            fx:controller="servicart.ui.controllers.PanelClienteController">

    <left>
        <VBox prefWidth="162"
              style="-fx-background-color: #111111;
                     -fx-border-color: #1e1e1e;
                     -fx-border-width: 0 1 0 0;">

            <VBox alignment="CENTER_LEFT"
                  style="-fx-border-color: #1e1e1e;
                         -fx-border-width: 0 0 1 0;
                         -fx-padding: 16 14 14 14;">
                <Label text="⚡ SERVICART"
                       style="-fx-text-fill: #e8c96d;
                              -fx-font-size: 12;
                              -fx-font-weight: bold;
                              -fx-font-family: 'Courier New';"/>
            </VBox>

            <Label text="MENÚ"
                   style="-fx-text-fill: #333333;
                          -fx-font-size: 9;
                          -fx-font-family: 'Courier New';
                          -fx-padding: 12 14 6 14;"/>

            <Button fx:id="btnMisServicios" maxWidth="Infinity"
                    text="Mis servicios" onAction="#onMisServicios"
                    style="-fx-background-color: #1a1a0d;
                           -fx-text-fill: #e8c96d;
                           -fx-border-color: #e8c96d;
                           -fx-border-width: 0 0 0 2;
                           -fx-border-radius: 0;
                           -fx-background-radius: 0;
                           -fx-font-size: 11;
                           -fx-padding: 9 14 9 12;
                           -fx-alignment: center-left;
                           -fx-cursor: hand;"/>

            <Button fx:id="btnCarrito" maxWidth="Infinity"
                    text="Carrito" onAction="#onCarrito"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #555555;
                           -fx-border-color: transparent;
                           -fx-border-radius: 0;
                           -fx-background-radius: 0;
                           -fx-font-size: 11;
                           -fx-padding: 9 14 9 14;
                           -fx-alignment: center-left;
                           -fx-cursor: hand;"/>

            <Button fx:id="btnPerfil" maxWidth="Infinity"
                    text="Perfil" onAction="#onPerfil"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #555555;
                           -fx-border-color: transparent;
                           -fx-border-radius: 0;
                           -fx-background-radius: 0;
                           -fx-font-size: 11;
                           -fx-padding: 9 14 9 14;
                           -fx-alignment: center-left;
                           -fx-cursor: hand;"/>

            <Region VBox.vgrow="ALWAYS"/>
            <Separator style="-fx-background-color: #1e1e1e;"/>

            <Button maxWidth="Infinity" text="⬅  Salir" onAction="#onSalir"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #c0392b;
                           -fx-border-color: transparent;
                           -fx-border-radius: 0;
                           -fx-background-radius: 0;
                           -fx-font-size: 11;
                           -fx-padding: 9 14 9 14;
                           -fx-alignment: center-left;
                           -fx-cursor: hand;">
                <VBox.margin>
                    <Insets bottom="6"/>
                </VBox.margin>
            </Button>
        </VBox>
    </left>

    <!-- ═══ CONTENIDO PRINCIPAL ═══ -->
    <center>
        <VBox style="-fx-background-color: #0f0f0f; -fx-padding: 20 22 20 22;">

            <!-- Header -->
            <HBox alignment="CENTER_LEFT">
                <Label text="Mis Servicios"
                       style="-fx-text-fill: #e8c96d;
                              -fx-font-size: 13;
                              -fx-font-weight: bold;
                              -fx-font-family: 'Courier New';"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblNombreCliente"
                       style="-fx-text-fill: #555555; -fx-font-size: 10;"/>
            </HBox>
            <Separator style="-fx-background-color: #222222;">
                <VBox.margin>
                    <Insets top="10" bottom="14"/>
                </VBox.margin>
            </Separator>

            <!-- Mensaje de feedback -->
            <Label fx:id="lblMensaje"
                   managed="false" visible="false"
                   maxWidth="Infinity" wrapText="true"
                   style="-fx-text-fill: #e8c96d;
                          -fx-font-size: 11;
                          -fx-font-family: 'Courier New';">
                <VBox.margin>
                    <Insets bottom="10"/>
                </VBox.margin>
            </Label>

            <!-- Contenedor dinámico de tarjetas (lo puebla el controller) -->
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                        style="-fx-background: #0f0f0f;
                               -fx-background-color: #0f0f0f;
                               -fx-border-color: transparent;">
                <VBox fx:id="contenedorServicios" spacing="10">
                    <padding>
                        <Insets bottom="16"/>
                    </padding>
                </VBox>
            </ScrollPane>
        </VBox>
    </center>

</BorderPane>
