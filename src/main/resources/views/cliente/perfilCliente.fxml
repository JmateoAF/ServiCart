<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="640" prefWidth="960"
            style="-fx-background-color: #0f0f0f;"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="servicart.ui.controllers.cliente.PerfilClienteController">

    <left>
        <VBox prefWidth="162"
              style="-fx-background-color: #111111; -fx-border-color: #1e1e1e; -fx-border-width: 0 1 0 0;">

            <VBox alignment="CENTER_LEFT"
                  style="-fx-border-color: #1e1e1e; -fx-border-width: 0 0 1 0; -fx-padding: 16 14 14 14;">
                <Label text="⚡ SERVICART"
                       style="-fx-text-fill: #e8c96d; -fx-font-size: 12; -fx-font-weight: bold; -fx-font-family: 'Courier New';" />
            </VBox>

            <Label text="MENÚ" style="-fx-text-fill: #333333; -fx-font-size: 9; -fx-font-family: 'Courier New'; -fx-padding: 12 14 6 14;" />

            <Button maxWidth="Infinity" text="⚡  Mis servicios" onAction="#onMisServicios"
                    style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-border-color: transparent; -fx-border-radius: 0; -fx-background-radius: 0; -fx-font-size: 11; -fx-padding: 9 14 9 14; -fx-alignment: center-left; -fx-cursor: hand;" />

            <Button maxWidth="Infinity" text="🛒  Carrito" onAction="#onCarrito"
                    style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-border-color: transparent; -fx-border-radius: 0; -fx-background-radius: 0; -fx-font-size: 11; -fx-padding: 9 14 9 14; -fx-alignment: center-left; -fx-cursor: hand;" />

            <Button maxWidth="Infinity" text="👤  Perfil"
                    style="-fx-background-color: #1a1a0d; -fx-text-fill: #e8c96d; -fx-border-color: #e8c96d; -fx-border-width: 0 0 0 2; -fx-border-radius: 0; -fx-background-radius: 0; -fx-font-size: 11; -fx-padding: 9 14 9 12; -fx-alignment: center-left; -fx-cursor: hand;" />

            <Region VBox.vgrow="ALWAYS" />
            <Separator style="-fx-background-color: #1e1e1e;" />
            <Button maxWidth="Infinity" text="⬅  Salir" onAction="#onSalir"
                    style="-fx-background-color: transparent; -fx-text-fill: #c0392b; -fx-border-color: transparent; -fx-border-radius: 0; -fx-background-radius: 0; -fx-font-size: 11; -fx-padding: 9 14 9 14; -fx-alignment: center-left; -fx-cursor: hand;">
                <VBox.margin><Insets bottom="6" /></VBox.margin>
            </Button>
        </VBox>
    </left>

    <center>
        <HBox alignment="TOP_CENTER" spacing="16"
              style="-fx-background-color: #0f0f0f; -fx-padding: 22 32 22 22;">

            <VBox spacing="12" HBox.hgrow="ALWAYS">

                <VBox alignment="CENTER" spacing="8"
                      style="-fx-background-color: #161616; -fx-border-color: #252525; -fx-border-width: 1; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 20 16 16 16;">
                    <Label text="👤"
                           style="-fx-font-size: 38; -fx-background-color: #1e1e1e; -fx-background-radius: 50; -fx-padding: 14 16 14 16;" />
                    <Label fx:id="lblNombreUsuario"
                           style="-fx-text-fill: #e8c96d; -fx-font-size: 14; -fx-font-weight: bold; -fx-font-family: 'Courier New';" />
                    <Label fx:id="lblEmailUsuario"
                           style="-fx-text-fill: #555555; -fx-font-size: 11;" />
                    <Label text="● Cuenta activa"
                           style="-fx-text-fill: #27ae60; -fx-background-color: #0f2a18; -fx-font-size: 10; -fx-padding: 3 10 3 10; -fx-background-radius: 10;" />
                </VBox>

                <VBox spacing="12"
                      style="-fx-background-color: #161616; -fx-border-color: #252525; -fx-border-width: 1; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 16;">

                    <Label text="DATOS PERSONALES"
                           style="-fx-text-fill: #444444; -fx-font-size: 9; -fx-font-family: 'Courier New'; -fx-border-color: #1e1e1e; -fx-border-width: 0 0 1 0; -fx-padding: 0 0 10 0;" />

                    <VBox spacing="4">
                        <Label text="Nombre completo" style="-fx-text-fill: #555555; -fx-font-size: 10;" />
                        <TextField fx:id="txtNombre" editable="false"
                                   style="-fx-background-color: #1a1a1a; -fx-border-color: #2a2a2a; -fx-border-width: 1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-text-fill: #cccccc; -fx-font-size: 12; -fx-padding: 8 12 8 12;" />
                    </VBox>

                    <VBox spacing="4">
                        <Label text="Cédula / RUC" style="-fx-text-fill: #555555; -fx-font-size: 10;" />
                        <TextField fx:id="txtCedula" editable="false"
                                   style="-fx-background-color: #1a1a1a; -fx-border-color: #2a2a2a; -fx-border-width: 1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-text-fill: #cccccc; -fx-font-size: 12; -fx-padding: 8 12 8 12; -fx-font-family: 'Courier New';" />
                    </VBox>

                    <VBox spacing="4">
                        <Label text="Correo electrónico" style="-fx-text-fill: #555555; -fx-font-size: 10;" />
                        <TextField fx:id="txtEmail" editable="false"
                                   style="-fx-background-color: #1a1a1a; -fx-border-color: #2a2a2a; -fx-border-width: 1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-text-fill: #cccccc; -fx-font-size: 12; -fx-padding: 8 12 8 12;" />
                    </VBox>

                    <VBox spacing="4">
                        <Label text="Teléfono" style="-fx-text-fill: #555555; -fx-font-size: 10;" />
                        <TextField fx:id="txtCelular" editable="false"
                                   style="-fx-background-color: #1a1a1a; -fx-border-color: #2a2a2a; -fx-border-width: 1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-text-fill: #cccccc; -fx-font-size: 12; -fx-padding: 8 12 8 12; -fx-font-family: 'Courier New';" />
                    </VBox>

                    <Label
                           alignment="CENTER" managed="false" maxWidth="Infinity"
                           style="-fx-text-fill: #e8c96d; -fx-font-size: 11; -fx-padding: 6 0 0 0;"
                           visible="false" />
                </VBox>
            </VBox>

            <VBox prefWidth="220" spacing="10">
                <Label text="SERVICIOS REGISTRADOS"
                       style="-fx-text-fill: #444444; -fx-font-size: 9; -fx-font-family: 'Courier New';" />
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                            style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-color: transparent;">
                    <VBox spacing="10" />
                </ScrollPane>
            </VBox>
        </HBox>
    </center>

</BorderPane>
