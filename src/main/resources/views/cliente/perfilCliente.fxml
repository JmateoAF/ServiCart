<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" stylesheets="@../../assets/css/styles.css"
            style="-fx-background-color: #0f0f0f;" xmlns="http://javafx.com/javafx/26"
            fx:controller="servicart.ui.controllers.cliente.PerfilClienteController">
    <left>
        <VBox prefWidth="200.0"
              style="-fx-background-color: #111111; -fx-border-color: #1e1e1e; -fx-border-width: 0 1 0 0;">
            <Label maxWidth="Infinity"
                   style="-fx-text-fill: #e8c96d; -fx-font-size: 25; -fx-font-weight: bold; -fx-font-family: 'Courier New'; -fx-border-color: #1e1e1e; -fx-border-width: 0 0 5 0; -fx-padding: 15 15 15 20;"
                   text="SERVICART"/>

            <Button maxWidth="Infinity" onAction="#onMisServicios"
                    style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-border-color: transparent; -fx-font-size: 20; -fx-padding: 10 15 10 15; -fx-alignment: center-left; -fx-cursor: hand;"
                    text="Mis servicios"/>

            <Button maxWidth="Infinity" onAction="#onCarrito"
                    style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-border-color: transparent; -fx-font-size: 20; -fx-padding: 10 15 10 15; -fx-alignment: center-left; -fx-cursor: hand;"
                    text="Carrito"/>

            <Button maxWidth="Infinity"
                    style="-fx-background-color: #1a1a0d; -fx-text-fill: #e8c96d; -fx-border-color: #e8c96d; -fx-border-width: 0 0 0 5; -fx-font-size: 20; -fx-padding: 10 15 10 10; -fx-alignment: center-left; -fx-cursor: hand;"
                    text="Perfil"/>

            <Region VBox.vgrow="ALWAYS"/>
            <Separator style="-fx-background-color: #1e1e1e;"/>
            <Button maxWidth="Infinity" onAction="#onSalir"
                    style="-fx-background-color: transparent; -fx-text-fill: #c0392b; -fx-border-color: transparent; -fx-font-size: 20; -fx-padding: 10 15 10 15; -fx-alignment: center-left; -fx-cursor: hand;"
                    text="Salir"/>
        </VBox>
    </left>
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;"
                    BorderPane.alignment="CENTER">
            <VBox spacing="15.0" style="-fx-padding: 20;">

                <VBox alignment="CENTER" spacing="10"
                      style="-fx-background-color: #161616; -fx-border-color: #252525; -fx-border-width: 1; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 20 15 15 15;">
                    <Label fx:id="lblNombreUsuario"
                           style="-fx-text-fill: #e8c96d; -fx-font-size: 25; -fx-font-weight: bold; -fx-font-family: 'Courier New';"/>
                    <Label fx:id="lblEmailUsuario" style="-fx-text-fill: #555555; -fx-font-size: 20;"/>
                    <Label style="-fx-text-fill: #27ae60; -fx-background-color: #0f2a18; -fx-font-size: 20; -fx-padding: 5 10 5 10; -fx-background-radius: 10;"
                           text="Cuenta activa"/>
                </VBox>

                <VBox spacing="10"
                      style="-fx-background-color: #161616; -fx-border-color: #252525; -fx-border-width: 1; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 15;">
                    <Label maxWidth="Infinity"
                           style="-fx-text-fill: #444444; -fx-font-size: 15; -fx-font-family: 'Courier New'; -fx-border-color: #1e1e1e; -fx-border-width: 0 0 1 0; -fx-padding: 0 0 10 0;"
                           text="DATOS PERSONALES"/>
                    <Label style="-fx-text-fill: #555555; -fx-font-size: 15;" text="Nombre completo"/>
                    <TextField fx:id="txtNombre" editable="false"
                               style="-fx-background-color: #1a1a1a; -fx-border-color: #2a2a2a; -fx-border-width: 1; -fx-border-radius: 5; -fx-background-radius: 5; -fx-text-fill: #cccccc; -fx-font-size: 15; -fx-padding: 10;"/>
                    <Label style="-fx-text-fill: #555555; -fx-font-size: 15;" text="Cédula"/>
                    <TextField fx:id="txtCedula" editable="false"
                               style="-fx-background-color: #1a1a1a; -fx-border-color: #2a2a2a; -fx-border-width: 1; -fx-border-radius: 5; -fx-background-radius: 5; -fx-text-fill: #cccccc; -fx-font-size: 15; -fx-padding: 10; -fx-font-family: 'Courier New';"/>
                    <Label style="-fx-text-fill: #555555; -fx-font-size: 15;" text="Correo electrónico"/>
                    <TextField fx:id="txtEmail" editable="false"
                               style="-fx-background-color: #1a1a1a; -fx-border-color: #2a2a2a; -fx-border-width: 1; -fx-border-radius: 5; -fx-background-radius: 5; -fx-text-fill: #cccccc; -fx-font-size: 15; -fx-padding: 10;"/>
                    <Label style="-fx-text-fill: #555555; -fx-font-size: 15;" text="Teléfono"/>
                    <TextField fx:id="txtCelular" editable="false"
                               style="-fx-background-color: #1a1a1a; -fx-border-color: #2a2a2a; -fx-border-width: 1; -fx-border-radius: 5; -fx-background-radius: 5; -fx-text-fill: #cccccc; -fx-font-size: 15; -fx-padding: 10; -fx-font-family: 'Courier New';"/>
                </VBox>

                <VBox spacing="10"
                      style="-fx-background-color: #161616; -fx-border-color: #252525; -fx-border-width: 1; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 15;">
                    <Label maxWidth="Infinity"
                           style="-fx-text-fill: #444444; -fx-font-size: 15; -fx-font-family: 'Courier New'; -fx-border-color: #1e1e1e; -fx-border-width: 0 0 1 0; -fx-padding: 0 0 10 0;"
                           text="MIS SERVICIOS CONTRATADOS"/>
                    <Label fx:id="lblMensaje" style="-fx-text-fill: #555555; -fx-font-size: 15;" visible="false"
                           managed="false"/>
                    <VBox fx:id="listaServicios" spacing="10"/>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>

</BorderPane>