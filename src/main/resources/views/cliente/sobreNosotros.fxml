<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" style="-fx-background-color: #0f0f0f;"
            stylesheets="@../../assets/css/styles.css" xmlns="http://javafx.com/javafx/26"
            fx:controller="servicart.ui.controllers.SobreNosotrosController">
    <top>
        <HBox alignment="CENTER_LEFT" maxHeight="-Infinity" spacing="10.0"
              style="-fx-background-color: #161616; -fx-border-color: #222222; -fx-border-width: 0 0 1 0; -fx-padding: 10 20 10 20;">
            <Label style="-fx-text-fill: #e8c96d; -fx-font-weight: bold; -fx-font-family: 'Courier New'; -fx-font-size: 25;"
                   text="SERVICART"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button onAction="#onVolver"
                    style="-fx-background-color: transparent; -fx-text-fill: #666666; -fx-border-color: transparent; -fx-cursor: hand; -fx-font-size: 20; -fx-padding: 5 15 5 15;"
                    text="Inicio"/>
            <Button style="-fx-background-color: #1f1f1f; -fx-text-fill: #e8c96d; -fx-border-color: #2a2a2a; -fx-border-width: 1; -fx-border-radius: 4; -fx-background-radius: 4; -fx-cursor: hand; -fx-font-size: 20; -fx-padding: 5 15 5 15;"
                    text="Sobre Nosotros"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToHeight="true" fitToWidth="true"
                    style="-fx-background: #0f0f0f; -fx-background-color: transparent; -fx-border-color: transparent;">
            <VBox alignment="CENTER" spacing="15.0" style="-fx-background-color: #0f0f0f; -fx-padding: 35 60 35 60;">
                <Label style="-fx-text-fill: #e8c96d; -fx-font-family: 'Courier New'; -fx-font-weight: bold; -fx-font-size: 25;"
                       text="SOBRE NOSOTROS"/>
                <Separator style="-fx-background-color: #252525;"/>
                <Label alignment="CENTER" maxWidth="Infinity"
                       style="-fx-background-color: #161616; -fx-border-color: #252525; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-width: 1; -fx-text-fill: #aaaaaa; -fx-font-family: 'Courier New'; -fx-line-spacing: 15; -fx-font-size: 15; -fx-padding: 20;"
                       text="ServiCart es una plataforma de pago de servicios básicos mediante carrito de compras. Permite visualizar y pagar sus facturas de agua, luz, recolección de basura e internet"
                       wrapText="true"/>
                <Separator style="-fx-background-color: #252525;"/>
                <HBox alignment="CENTER" spacing="15.0">
                    <Region HBox.hgrow="ALWAYS"/>
                    <VBox alignment="CENTER" spacing="10.0"
                          style="-fx-background-color: #161616; -fx-border-color: #252525; -fx-border-width: 1; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 20;">
                        <Label style="-fx-text-fill: #e8c96d; -fx-font-family: 'Courier New'; -fx-font-weight: bold; -fx-font-size: 20;"
                               text="ETAPA"/>
                        <Label style="-fx-text-fill: #555555; -fx-font-size: 15;" text="Agua Potable"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <VBox alignment="CENTER" spacing="10.0"
                          style="-fx-background-color: #161616; -fx-border-color: #252525; -fx-border-width: 1; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 20;">
                        <Label style="-fx-text-fill: #e8c96d; -fx-font-family: 'Courier New'; -fx-font-weight: bold; -fx-font-size: 20;"
                               text="CENTROSUR"/>
                        <Label style="-fx-text-fill: #555555; -fx-font-size: 15;" text="Electricidad"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <VBox alignment="CENTER" spacing="10.0"
                          style="-fx-background-color: #161616; -fx-border-color: #252525; -fx-border-width: 1; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 20;">
                        <Label style="-fx-text-fill: #e8c96d; -fx-font-family: 'Courier New'; -fx-font-weight: bold; -fx-font-size: 20;"
                               text="EMAC"/>
                        <Label style="-fx-text-fill: #555555; -fx-font-size: 15;" text="Recolección de basura"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <VBox alignment="CENTER" spacing="10.0"
                          style="-fx-background-color: #161616; -fx-border-color: #252525; -fx-border-width: 1; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 20;">
                        <Label style="-fx-text-fill: #e8c96d; -fx-font-family: 'Courier New'; -fx-font-weight: bold; -fx-font-size: 20;"
                               text="FIBRAMAX"/>
                        <Label style="-fx-text-fill: #555555; -fx-font-size: 15;" text="Internet"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                </HBox>
                <Separator style="-fx-background-color: #252525;"/>
                <Label style="-fx-text-fill: #444444; -fx-font-family: 'Courier New'; -fx-font-size: 20;"
                       text="DESARROLLADO POR"/>
                <HBox alignment="CENTER">
                    <VBox alignment="CENTER" spacing="10.0"
                          style="-fx-background-color: #161616; -fx-border-color: #222222; -fx-border-width: 1; -fx-border-radius: 10; -fx-background-radius: 10;">
                        <StackPane style="-fx-padding: 25 30 30 30;">
                            <ImageView fitHeight="500.0" fitWidth="500.0">
                                <Image url="@../../assets/img/Ai Hoshino.jpg"/>
                            </ImageView>
                        </StackPane>
                        <Label style="-fx-text-fill: #aaaaaa; -fx-font-size: 20; -fx-padding: 0 0 10 0;"
                               text="Jostin Aucancela"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" prefHeight="200.0" prefWidth="200.0"/>
                    <VBox alignment="CENTER" spacing="10.0"
                          style="-fx-background-color: #161616; -fx-border-color: #222222; -fx-border-width: 1; -fx-border-radius: 10; -fx-background-radius: 10;">
                        <StackPane style="-fx-padding: 25 30 30 30;">
                            <ImageView fitHeight="500.0" fitWidth="500.0">
                                <Image url="@../../assets/img/Hornet.jpg"/>
                            </ImageView>
                        </StackPane>
                        <Label style="-fx-text-fill: #aaaaaa; -fx-font-size: 20; -fx-padding: 0 0 10 0;"
                               text="Maritza Quishpi"/>
                    </VBox>
                </HBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
