<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="640" prefWidth="960"
            style="-fx-background-color: #0f0f0f;"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="servicart.ui.controllers.CarritoController">

    <!-- ═══ SIDEBAR ═══ -->
    <left>
        <VBox prefWidth="162"
              style="-fx-background-color: #111111;
                     -fx-border-color: #1e1e1e;
                     -fx-border-width: 0 1 0 0;">

            <VBox alignment="CENTER_LEFT"
                  style="-fx-border-color: #1e1e1e; -fx-border-width: 0 0 1 0; -fx-padding: 16 14 14 14;">
                <Label text="⚡ SERVICART"
                       style="-fx-text-fill: #e8c96d; -fx-font-size: 12; -fx-font-weight: bold; -fx-font-family: 'Courier New';" />
            </VBox>

            <Label text="MENÚ" style="-fx-text-fill: #333333; -fx-font-size: 9; -fx-font-family: 'Courier New'; -fx-padding: 12 14 6 14;" />

            <Button maxWidth="Infinity" text="⚡  Mis servicios" onAction="#onMisServicios"
                    style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-border-color: transparent; -fx-border-radius: 0; -fx-background-radius: 0; -fx-font-size: 11; -fx-padding: 9 14 9 14; -fx-alignment: center-left; -fx-cursor: hand;" />

            <Button maxWidth="Infinity" text="🛒  Carrito"
                    style="-fx-background-color: #1a1a0d; -fx-text-fill: #e8c96d; -fx-border-color: #e8c96d; -fx-border-width: 0 0 0 2; -fx-border-radius: 0; -fx-background-radius: 0; -fx-font-size: 11; -fx-padding: 9 14 9 12; -fx-alignment: center-left; -fx-cursor: hand;" />

            <Button maxWidth="Infinity" text="👤  Perfil" onAction="#onPerfil"
                    style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-border-color: transparent; -fx-border-radius: 0; -fx-background-radius: 0; -fx-font-size: 11; -fx-padding: 9 14 9 14; -fx-alignment: center-left; -fx-cursor: hand;" />

            <Region VBox.vgrow="ALWAYS" />
            <Separator style="-fx-background-color: #1e1e1e;" />
            <Button maxWidth="Infinity" text="⬅  Salir" onAction="#onSalir"
                    style="-fx-background-color: transparent; -fx-text-fill: #c0392b; -fx-border-color: transparent; -fx-border-radius: 0; -fx-background-radius: 0; -fx-font-size: 11; -fx-padding: 9 14 9 14; -fx-alignment: center-left; -fx-cursor: hand;">
                <VBox.margin><Insets bottom="6" /></VBox.margin>
            </Button>
        </VBox>
    </left>

    <!-- ═══ CONTENIDO ═══ -->
    <center>
        <VBox style="-fx-background-color: #0f0f0f; -fx-padding: 20 22 20 22;">

            <!-- Header -->
            <HBox alignment="CENTER_LEFT">
                <Label text="🛒 Carrito de compras"
                       style="-fx-text-fill: #e8c96d; -fx-font-size: 13; -fx-font-weight: bold; -fx-font-family: 'Courier New';" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="lblCantidad" style="-fx-text-fill: #555555; -fx-font-size: 10;" />
            </HBox>
            <Separator style="-fx-background-color: #222222;">
                <VBox.margin><Insets top="10" bottom="14" /></VBox.margin>
            </Separator>

            <!-- Estado vacío -->
            <VBox fx:id="paneVacio" alignment="CENTER" spacing="10"
                  managed="false" visible="false" VBox.vgrow="ALWAYS">
                <Label text="🛒" style="-fx-font-size: 48;" />
                <Label text="Tu carrito está vacío"
                       style="-fx-text-fill: #e8c96d; -fx-font-size: 13; -fx-font-family: 'Courier New'; -fx-font-weight: bold;" />
                <Label text="Añade abonos desde Mis Servicios"
                       style="-fx-text-fill: #555555; -fx-font-size: 11;" />
                <Button text="← Ir a mis servicios" onAction="#onMisServicios"
                        style="-fx-background-color: #e8c96d; -fx-text-fill: #0f0f0f; -fx-font-size: 11; -fx-font-weight: bold; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 9 18 9 18; -fx-cursor: hand;">
                    <VBox.margin><Insets top="10" /></VBox.margin>
                </Button>
            </VBox>

            <!-- Lista de ítems -->
            <VBox VBox.vgrow="ALWAYS" spacing="10">
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                            style="-fx-background: #0f0f0f; -fx-background-color: #0f0f0f; -fx-border-color: transparent;">
                    <VBox fx:id="listaItems" spacing="6">
                        <padding><Insets bottom="10" /></padding>
                    </VBox>
                </ScrollPane>

                <!-- Resumen total -->
                <VBox style="-fx-background-color: #161616; -fx-border-color: #252525; -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 14;"
                      spacing="8">
                    <HBox>
                        <Label text="Subtotal" style="-fx-text-fill: #666666; -fx-font-size: 12;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblSubtotal" text="0.00" style="-fx-text-fill: #aaaaaa; -fx-font-size: 12;" />
                    </HBox>
                    <Separator style="-fx-background-color: #2a2a2a;" />
                    <HBox>
                        <Label text="TOTAL"
                               style="-fx-text-fill: #e8c96d; -fx-font-size: 13; -fx-font-weight: bold; -fx-font-family: 'Courier New';" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblTotalFinal" text="0.00"
                               style="-fx-text-fill: #e8c96d; -fx-font-family: 'Courier New'; -fx-font-size: 16; -fx-font-weight: bold;" />
                    </HBox>
                    <HBox spacing="10">
                        <VBox.margin><Insets top="4" /></VBox.margin>
                        <Button fx:id="btnVaciarCarrito" text="Vaciar carrito"
                                onAction="#onVaciarCarrito"
                                HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-border-color: #2a2a2a; -fx-border-width: 1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 12; -fx-padding: 9 0 9 0; -fx-cursor: hand;" />
                        <Button fx:id="btnCheckout" text="Pagar ahora →"
                                onAction="#onCheckout"
                                HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                style="-fx-background-color: #e8c96d; -fx-text-fill: #0f0f0f; -fx-font-size: 12; -fx-font-weight: bold; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 9 0 9 0; -fx-cursor: hand;" />
                    </HBox>
                </VBox>
            </VBox>
        </VBox>
    </center>

</BorderPane>
