<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane prefWidth="900" prefHeight="620"
            style="-fx-background-color: #0f0f0f;"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml">

    <top>
        <HBox alignment="CENTER_LEFT"
              style="-fx-background-color: #161616; -fx-border-color: #222222; -fx-border-width: 0 0 1 0; -fx-padding: 11 20 11 20;">
            <Label text="SERVICART"
                   style="-fx-text-fill: #e8c96d; -fx-font-size: 14; -fx-font-weight: bold; -fx-font-family: 'Courier New';"/>
        </HBox>
    </top>

    <!-- Sidebar -->
    <left>
        <VBox prefWidth="150"
              style="-fx-background-color: #111111; -fx-border-color: #1e1e1e; -fx-border-width: 0 1 0 0;">

            <Label text="SC"
                   style="-fx-text-fill: #e8c96d; -fx-font-size: 11; -fx-font-family: 'Courier New'; -fx-font-weight: bold; -fx-padding: 0 14 12 14; -fx-border-color: #1e1e1e; -fx-border-width: 0 0 1 0;"/>

            <Button text="⚡ Mis servicios" maxWidth="Infinity"
                    style="-fx-background-color: #1a1a0d; -fx-text-fill: #e8c96d; -fx-border-color: #e8c96d; -fx-border-width: 0 0 0 2; -fx-border-radius: 0; -fx-background-radius: 0; -fx-font-size: 11; -fx-padding: 8 14 8 12; -fx-alignment: center-left; -fx-cursor: hand;">
                <VBox.margin><Insets top="6"/></VBox.margin>
            </Button>
            <Button text="🛒 Carrito" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-border-color: transparent; -fx-font-size: 11; -fx-padding: 8 14 8 14; -fx-alignment: center-left; -fx-cursor: hand;"/>
            <Button text="🧾 Historial" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-border-color: transparent; -fx-font-size: 11; -fx-padding: 8 14 8 14; -fx-alignment: center-left; -fx-cursor: hand;"/>
            <Button text="👤 Perfil" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-border-color: transparent; -fx-font-size: 11; -fx-padding: 8 14 8 14; -fx-alignment: center-left; -fx-cursor: hand;"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Button text="⬅ Salir" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #c0392b; -fx-border-color: transparent; -fx-font-size: 11; -fx-padding: 8 14 8 14; -fx-alignment: center-left; -fx-cursor: hand;"/>
        </VBox>
    </left>

    <!-- Main content -->
    <center>
        <HBox spacing="14"
              style="-fx-background-color: #0f0f0f; -fx-padding: 16 18 18 18;">

            <!-- Columna servicios -->
            <VBox spacing="10" HBox.hgrow="ALWAYS">
                <Label text="MIS SERVICIOS"
                       style="-fx-text-fill: #555555; -fx-font-size: 10; -fx-font-family: 'Courier New';"/>

                <!-- ETAPA -->
                <VBox spacing="6"
                      style="-fx-background-color: #161616; -fx-border-color: #252525; -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12;">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="💧 ETAPA  (Agua)"
                               style="-fx-text-fill: #e8c96d; -fx-font-size: 12; -fx-font-family: 'Courier New';"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="Con mora"
                               style="-fx-text-fill: #c0392b; -fx-background-color: #2a1010; -fx-font-size: 9; -fx-padding: 2 6 2 6; -fx-background-radius: 4;"/>
                    </HBox>
                    <HBox>
                        <Label text="Monto" style="-fx-text-fill: #555555; -fx-font-size: 11;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="$25.00" style="-fx-text-fill: #aaaaaa; -fx-font-size: 11;"/>
                    </HBox>
                    <HBox>
                        <Label text="Mora" style="-fx-text-fill: #555555; -fx-font-size: 11;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="$2.00" style="-fx-text-fill: #aaaaaa; -fx-font-size: 11;"/>
                    </HBox>
                    <HBox spacing="6">
                        <VBox.margin><Insets top="4"/></VBox.margin>
                        <TextField text="10.00" HBox.hgrow="ALWAYS"
                                   style="-fx-background-color: #1a1a1a; -fx-border-color: #2a2a2a; -fx-border-width: 1; -fx-border-radius: 4; -fx-background-radius: 4; -fx-text-fill: #aaaaaa; -fx-font-size: 11; -fx-padding: 5 8 5 8; -fx-font-family: 'Courier New';"/>
                        <Button text="Añadir"
                                style="-fx-background-color: #1c2a1c; -fx-text-fill: #4caf50; -fx-border-color: #2a3e2a; -fx-border-width: 1; -fx-border-radius: 4; -fx-background-radius: 4; -fx-font-size: 11; -fx-padding: 5 10 5 10; -fx-cursor: hand;"/>
                    </HBox>
                </VBox>

                <!-- CentroSur -->
                <VBox spacing="6"
                      style="-fx-background-color: #161616; -fx-border-color: #252525; -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12;">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="⚡ CentroSur  (Luz)"
                               style="-fx-text-fill: #e8c96d; -fx-font-size: 12; -fx-font-family: 'Courier New';"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="Al día"
                               style="-fx-text-fill: #27ae60; -fx-background-color: #0f2a18; -fx-font-size: 9; -fx-padding: 2 6 2 6; -fx-background-radius: 4;"/>
                    </HBox>
                    <HBox>
                        <Label text="Monto" style="-fx-text-fill: #555555; -fx-font-size: 11;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="$15.00" style="-fx-text-fill: #aaaaaa; -fx-font-size: 11;"/>
                    </HBox>
                    <HBox spacing="6">
                        <VBox.margin><Insets top="4"/></VBox.margin>
                        <TextField text="15.00" HBox.hgrow="ALWAYS"
                                   style="-fx-background-color: #1a1a1a; -fx-border-color: #2a2a2a; -fx-border-width: 1; -fx-border-radius: 4; -fx-background-radius: 4; -fx-text-fill: #aaaaaa; -fx-font-size: 11; -fx-padding: 5 8 5 8; -fx-font-family: 'Courier New';"/>
                        <Button text="Añadir"
                                style="-fx-background-color: #1c2a1c; -fx-text-fill: #4caf50; -fx-border-color: #2a3e2a; -fx-border-width: 1; -fx-border-radius: 4; -fx-background-radius: 4; -fx-font-size: 11; -fx-padding: 5 10 5 10; -fx-cursor: hand;"/>
                    </HBox>
                </VBox>
            </VBox>

            <!-- Carrito -->
            <VBox spacing="10" prefWidth="210">
                <Label text="CARRITO 🛒"
                       style="-fx-text-fill: #555555; -fx-font-size: 10; -fx-font-family: 'Courier New';"/>
                <VBox spacing="0"
                      style="-fx-background-color: #161616; -fx-border-color: #252525; -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12;">
                    <HBox style="-fx-border-color: #1e1e1e; -fx-border-width: 0 0 1 0; -fx-padding: 0 0 5 0;">
                        <Label text="ETAPA (Agua)" style="-fx-text-fill: #777777; -fx-font-size: 11;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="$10.00" style="-fx-text-fill: #e8c96d; -fx-font-size: 11;"/>
                    </HBox>
                    <HBox style="-fx-padding: 5 0 0 0;">
                        <Label text="CentroSur (Luz)" style="-fx-text-fill: #777777; -fx-font-size: 11;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="$15.00" style="-fx-text-fill: #e8c96d; -fx-font-size: 11;"/>
                    </HBox>
                    <Separator>
                        <VBox.margin><Insets top="12" bottom="8"/></VBox.margin>
                    </Separator>
                    <HBox>
                        <Label text="Total" style="-fx-text-fill: #aaaaaa; -fx-font-size: 12;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="$25.00" style="-fx-text-fill: #e8c96d; -fx-font-size: 12; -fx-font-weight: bold;"/>
                    </HBox>
                    <Button text="CHECK OUT →" maxWidth="Infinity"
                            style="-fx-background-color: #e8c96d; -fx-text-fill: #0f0f0f; -fx-font-size: 12; -fx-font-weight: bold; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 9 0 9 0; -fx-cursor: hand;">
                        <VBox.margin><Insets top="10"/></VBox.margin>
                    </Button>
                </VBox>
            </VBox>

        </HBox>
    </center>

</BorderPane>
