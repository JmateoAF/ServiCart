<?xml version="1.0" encoding="UTF-8"?>
        <?import javafx.scene.control.*?>
        <?import javafx.scene.layout.*?>
        <?import javafx.geometry.Insets?>

<BorderPane prefWidth="800" prefHeight="600" style="-fx-background-color: #0f0f0f;" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
    <top>
        <VBox>
            <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: #161616; -fx-border-color: #222222; -fx-border-width: 0 0 1 0; -fx-padding: 12 20 12 20;">
                <Label text="SERVICART" style="-fx-text-fill: #e8c96d; -fx-font-size: 15; -fx-font-weight: bold; -fx-font-family: 'Courier New';"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="inicio" style="-fx-background-color: #1f1f1f; -fx-text-fill: #e8c96d; -fx-border-color: #2a2a2a; -fx-border-width: 1; -fx-border-radius: 4; -fx-background-radius: 4; -fx-font-size: 12; -fx-padding: 5 14 5 14; -fx-cursor: hand;"/>
                <Button text="sobre nosotros" style="-fx-background-color: transparent; -fx-text-fill: #666666; -fx-border-color: transparent; -fx-font-size: 12; -fx-padding: 5 14 5 14; -fx-cursor: hand;"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" style="-fx-background-color: #161616; -fx-border-color: #222222; -fx-border-width: 1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 10 16 10 16;">
                <HBox.margin>
                    <Insets top="16" right="20" left="20"/>
                </HBox.margin>

                <Label text="👤  Cliente: 0102030405" style="-fx-text-fill: #e8c96d; -fx-font-size: 13; -fx-font-family: 'Courier New';"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Cerrar" style="-fx-background-color: #1a1a1a; -fx-text-fill: #555555; -fx-border-color: #2a2a2a; -fx-border-width: 1; -fx-border-radius: 4; -fx-background-radius: 4; -fx-font-size: 12; -fx-padding: 4 10 4 10; -fx-cursor: hand;"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <HBox spacing="14" style="-fx-background-color: #0f0f0f; -fx-padding: 16 20 20 20;">
