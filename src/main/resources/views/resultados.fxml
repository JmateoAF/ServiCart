                <Label text="FACTURAS PENDIENTES" style="-fx-text-fill: #555555; -fx-font-size: 11;"/>

                <VBox spacing="6" style="-fx-background-color: #161616; -fx-border-color: #252525; -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 14;">
                    <Label text="💧  ETAPA   (Agua)" style="-fx-text-fill: #e8c96d; -fx-font-size: 13; -fx-font-family: 'Courier New';"/>

                    <HBox>
                        <Label text="Monto total" style="-fx-text-fill: #666666; -fx-font-size: 12;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="25.00" style="-fx-text-fill: #aaaaaa; -fx-font-size: 12;"/>
                    </HBox>

                    <HBox>
                        <Label text="Interés mora" style="-fx-text-fill: #666666; -fx-font-size: 12;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="2.00" style="-fx-text-fill: #aaaaaa; -fx-font-size: 12;"/>
                    </HBox>

                    <HBox>
                        <Label text="Estado" style="-fx-text-fill: #666666; -fx-font-size: 12;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="Activo con mora" style="-fx-text-fill: #c0392b; -fx-font-size: 11;"/>
                    </HBox>

                    <HBox spacing="6">
                        <VBox.margin><Insets top="4"/></VBox.margin>
                        <TextField text="10.00" HBox.hgrow="ALWAYS" style="-fx-background-color: #1a1a1a; -fx-border-color: #2a2a2a; -fx-border-width: 1; -fx-border-radius: 4; -fx-background-radius: 4; -fx-text-fill: #aaaaaa; -fx-font-size: 12; -fx-padding: 6 10 6 10; -fx-font-family: 'Courier New';"/>
                        <Button text="Añadir" style="-fx-background-color: #1c2a1c; -fx-text-fill: #4caf50; -fx-border-color: #2a3e2a; -fx-border-width: 1; -fx-border-radius: 4; -fx-background-radius: 4; -fx-font-size: 12; -fx-padding: 6 12 6 12; -fx-cursor: hand;"/>
                    </HBox>
                </VBox>

                <VBox spacing="6" style="-fx-background-color: #161616; -fx-border-color: #252525; -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 14;">
                    <Label text="⚡  CentroSur   (Electricidad)" style="-fx-text-fill: #e8c96d; -fx-font-size: 13; -fx-font-family: 'Courier New';"/>

                    <HBox>
                        <Label text="Monto total" style="-fx-text-fill: #666666; -fx-font-size: 12;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="15.00" style="-fx-text-fill: #aaaaaa; -fx-font-size: 12;"/>
                    </HBox>

                    <HBox>
                        <Label text="Estado" style="-fx-text-fill: #666666; -fx-font-size: 12;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="Al día ✓" style="-fx-text-fill: #27ae60; -fx-font-size: 11;"/>
                    </HBox>

                    <HBox spacing="6">
                        <VBox.margin><Insets top="4"/></VBox.margin>
                        <TextField text="15.00" HBox.hgrow="ALWAYS" style="-fx-background-color: #1a1a1a; -fx-border-color: #2a2a2a; -fx-border-width: 1; -fx-border-radius: 4; -fx-background-radius: 4; -fx-text-fill: #aaaaaa; -fx-font-size: 12; -fx-padding: 6 10 6 10; -fx-font-family: 'Courier New';"/>
                        <Button text="Añadir" style="-fx-background-color: #1c2a1c; -fx-text-fill: #4caf50; -fx-border-color: #2a3e2a; -fx-border-width: 1; -fx-border-radius: 4; -fx-background-radius: 4; -fx-font-size: 12; -fx-padding: 6 12 6 12; -fx-cursor: hand;"/>
                    </HBox>
                </VBox>
            </VBox>

            <VBox spacing="10" prefWidth="220">
                <Label text="TU SERVICART 🛒" style="-fx-text-fill: #555555; -fx-font-size: 11;"/>

                <VBox style="-fx-background-color: #161616; -fx-border-color: #252525; -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 14;">
                    <HBox style="-fx-border-color: #1e1e1e; -fx-border-width: 0 0 1 0; -fx-padding: 0 0 5 0;">
                        <Label text="ETAPA (Agua)" style="-fx-text-fill: #888888; -fx-font-size: 12;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="10.00" style="-fx-text-fill: #e8c96d; -fx-font-size: 12;"/>
                    </HBox>

                    <HBox style="-fx-padding: 5 0 0 0;">
                        <Label text="CentroSur (Luz)" style="-fx-text-fill: #888888; -fx-font-size: 12;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="15.00" style="-fx-text-fill: #e8c96d; -fx-font-size: 12;"/>
                    </HBox>

                    <Separator>
                        <VBox.margin><Insets top="14" bottom="10"/></VBox.margin>
                    </Separator>

                    <HBox>
                        <Label text="Total" style="-fx-text-fill: #aaaaaa; -fx-font-size: 13;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="25.00" style="-fx-text-fill: #e8c96d; -fx-font-size: 13; -fx-font-weight: bold;"/>
                    </HBox>

                    <Button text="CHECK OUT →" maxWidth="Infinity" style="-fx-background-color: #e8c96d; -fx-text-fill: #0f0f0f; -fx-font-size: 13; -fx-font-weight: bold; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 10 0 10 0; -fx-cursor: hand;">
                        <VBox.margin><Insets top="12"/></VBox.margin>
                    </Button>
                </VBox>
            </VBox>
        </HBox>
    </center>
</BorderPane>